<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ autostart_domain }}.{{ item.name | lower | regex_replace('[^a-z0-9]+', '-') }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
{% if item.hidden | default(false) %}
    <string>-j</string>
{% endif %}
    <string>-a</string>
    <string>{{ item.name }}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
