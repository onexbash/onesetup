---
extends: default

rules:
  indentation:
    spaces: consistent
    indent-sequences: consistent
  line-length:
    max: 250
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .github/workflows/stale.yml
