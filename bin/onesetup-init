#!/usr/bin/env bash

# --                              -- #
# --     ONESETUP-INIT BINARY     -- #
# --                              -- #
# Rolled out by 'install.sh' | Installs/updates the project & rolls out its executables

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Ensure prerequisites are satisfied
  install_deps "git" "gum" "ansible"

  # [3] Install / update the project repository
  sync_repository

  # [4] Ensure directory permissions & ownership
  ensure_directories

  # [5] Roll out executables
  rollout_executables

  # [6] Install Ansible collections from Ansible Galaxy
  install_collections

  # [7] Create the config file from the example (never overwrites an existing one)
  create_config
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    sleep 3
    exit 1
  }
}

# --                 -- #
# --     INSTALL     -- #
# --                 -- #

# Clone the project into the install dir, or re-clone it if broken/outdated
function sync_repository() {
  local install_dir="$ONESETUP_INSTALL_DIR"
  local repo_uri="$ONESETUP_REPO"
  local local_sha="" remote_sha=""

  # Remove installation directory if it is not a git repository (broken/corrupted)
  if [[ -d "$install_dir" ]] && ! git -C "$install_dir" rev-parse --git-dir &>/dev/null; then
    rm -rf "${install_dir:?}"
    log_info "There was a broken installation at ${install_dir}. Deletion complete."
  fi

  if [[ -d "$install_dir" ]]; then
    # Compare local commit hash with latest remote ('|| true': a failing ls-remote must not trip 'pipefail')
    local_sha="$(git -C "$install_dir" rev-parse HEAD 2>/dev/null || true)"
    remote_sha="$(git ls-remote "$repo_uri" "refs/heads/${ONESETUP_BRANCH}" 2>/dev/null | awk '{print $1}' || true)"

    if [[ -z "$remote_sha" ]]; then
      # Remote unreachable → keep the working installation instead of deleting it
      log_warn "Failed to verify remote commit hash (${repo_uri}). Keeping existing installation."
      return 0
    elif [[ "$local_sha" == "$remote_sha" ]]; then
      log_ok "The installation directory is up-to-date with the remote (${repo_uri})."
      log_skip "Skipping installation..."
      return 0
    fi

    log_warn "Installation directory is outdated."
    log_info "Updating to latest version..."
    rm -rf "${install_dir:?}"
  else
    log_info "No installation found for 'onesetup'. Installing to ${install_dir}..."
  fi

  git clone --depth 1 --single-branch --branch "$ONESETUP_BRANCH" "$repo_uri" "$install_dir" || {
    log_err "Failed to clone ${repo_uri} (branch: ${ONESETUP_BRANCH}) into ${install_dir}"
    exit 1
  }
  log_ok "Installation complete!"
}

# Ensure directory presence, permissions & ownership
function ensure_directories() {
  local user_owner
  user_owner="$(id -un):$(id -gn)"

  ensure_directory "$(dirname "$ONESETUP_CONFIG")" "700" "$user_owner" false
  ensure_directory "$ONESETUP_INSTALL_DIR" "700" "$user_owner" true
  ensure_directory "$ONESETUP_STATE_DIR" "700" "$user_owner" true
}

# Copy all executables from <install_dir>/bin to the bin dir
function rollout_executables() {
  local bin_dir="$ONESETUP_BIN_DIR"
  local rc=0 file filename root_user root_group
  root_user="$(id -nu 0)"
  root_group="$(id -ng 0)"

  is_writable "$bin_dir" || rc=$?
  case "$rc" in
  0) ;;
  2) {
    # is_writable already reported the missing directory
    log_info "Please create it or export ONESETUP_BIN_DIR=<dir>, then re-run onesetup-init."
    exit 1
  } ;;
  *) {
    log_err "The Bin-Directory you've set is not writable, which is mostly caused by macOS System Integrity Protection. Please export ONESETUP_BIN_DIR=<dir> with a Directory that is writable with sudo rights."
    log_info "Please re-run onesetup-init after."
    exit 1
  } ;;
  esac

  for file in "${ONESETUP_INSTALL_DIR}"/bin/*; do
    [[ -f "$file" ]] || continue
    filename="$(basename "$file")"
    sudo install -m 755 -o "$root_user" -g "$root_group" "$file" "${bin_dir}/${filename}" || {
      log_err "Failed to roll-out executable ${C_RED}${filename}${C_RESET} to ${C_RED}${bin_dir}${C_RESET}"
      exit 1
    }
    log_ok "${C_GREEN}${filename}${C_RESET} copied to ${C_GREEN}${bin_dir}${C_RESET}"
  done
}

# Install Ansible collections listed in requirements.yml
function install_collections() {
  ansible-galaxy collection install \
    --requirements-file "${ONESETUP_INSTALL_DIR}/requirements.yml" \
    --no-cache --upgrade || {
    log_err "Failed to install Ansible collections."
    exit 1
  }
}

# Copy config.base.yml to ONESETUP_CONFIG if there is no config file yet
function create_config() {
  if [[ -e "$ONESETUP_CONFIG" ]]; then
    log_ok "Config file found: ${C_CYAN}${ONESETUP_CONFIG}${C_RESET}"
    return 0
  fi
  # 600: the config file can hold vault-encrypted secrets
  install -m 600 "${ONESETUP_INSTALL_DIR}/config.base.yml" "$ONESETUP_CONFIG" || {
    log_err "Failed to create the config file: ${ONESETUP_CONFIG}"
    exit 1
  }
  log_ok "Config file created: ${C_CYAN}${ONESETUP_CONFIG}${C_RESET}"
  log_info "Adjust it to your needs, then run 'onesetup'."
}

# Call Main Function with args
main "$@"
