#!/usr/bin/env bash

# --                         -- #
# --     ONESETUP BINARY     -- #
# --                         -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup'

# -- GLOBALS -- #
SUBCMD=""        # run | test | help | "" (empty → interactive prompt)
ARG_INCLUDE=""   # --include <tags>
ARG_SKIP=""      # --skip <tags>
ARG_DEV_DIR=""   # --dev-dir <path>
ARG_DIFF="false" # --diff (test only)

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [3] Setup (dependencies, target dir)
  setup

  # [4] Ask for the subcommand if none was given
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    if [[ -z "$SUBCMD" ]]; then
      echo -e "${I_WARN}Operation cancelled."
      exit 0
    fi
    validate_args
  fi

  # [5] Run
  run_playbook
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    exit 1
  }
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD & ARG_*, no side effects)
function parse_args() {
  # Optional subcommand as first argument
  case "${1:-}" in
  run | test)
    SUBCMD="$1"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (options still allowed)
  *)
    print_help >&2
    echo -e "${I_ERR}Unknown command: $1"
    exit 1
    ;;
  esac

  # Options
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --include)
      require_value "$1" "${2:-}"
      ARG_INCLUDE="$2"
      shift 2
      ;;
    --skip)
      require_value "$1" "${2:-}"
      ARG_SKIP="$2"
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    --diff)
      ARG_DIFF="true"
      shift
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    *)
      # shellcheck disable=SC2016 # false positive: expands inside the double quotes
      echo -e "${I_ERR}Unknown option${SUBCMD:+ for '${SUBCMD}'}: $1"
      exit 1
      ;;
    esac
  done

  validate_args
}

# Validate option combinations (called again after the interactive prompt)
function validate_args() {
  if [[ "$SUBCMD" == "run" && "$ARG_DIFF" == "true" ]]; then
    echo -e "${I_ERR}Flag '--diff' is only valid for 'test'."
    exit 1
  fi
  if [[ -n "$ARG_INCLUDE" && -n "$ARG_SKIP" ]]; then
    echo -e "${I_ERR}Use either '--include' or '--skip', not both."
    exit 1
  fi
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  run                         Run the Ansible playbook
  test                        Test the playbook without applying changes (--check)
  help, --help, -h            Display this help message
  (none)                      Choose a command interactively

Options:
  --include <tag1,tag2>       Only run these roles/tags
  --skip <tag1,tag2>          Skip these roles/tags
  --dev-dir <path>            Use a local project directory instead of the installed one
  --diff                      Show content diffs (only with 'test')
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to run the playbook
function setup() {
  # gum is only needed for the interactive prompt
  if [[ -z "$SUBCMD" ]]; then
    install_deps "ansible" "gum"
  else
    install_deps "ansible"
  fi

  use_dev_dir "$ARG_DEV_DIR"
}

# --             -- #
# --     RUN     -- #
# --             -- #

# Ask for the subcommand (prints "run", "test" or nothing if canceled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Run Playbook" "Test Playbook")" in
  "Run Playbook") echo "run" ;;
  "Test Playbook") echo "test" ;;
  esac
}

# Build the ansible-playbook arguments from SUBCMD & ARG_* and run the playbook
function run_playbook() {
  local playbook="${X_TARGET_DIR}/main.yml"
  local args=("--ask-vault-pass")

  [[ -f "$playbook" && -r "$playbook" ]] || {
    echo -e "${I_ERR}No readable Playbook Entrypoint found at: ${C_CYAN}${playbook}${C_RESET}"
    exit 1
  }

  # 'test' → dry run (+ optional diffs)
  if [[ "$SUBCMD" == "test" ]]; then
    args+=("--check")
    if [[ "$ARG_DIFF" == "true" ]]; then
      args+=("--diff")
    fi
  fi

  # Tag filters
  if [[ -n "$ARG_INCLUDE" ]]; then
    args+=("--tags" "${ARG_INCLUDE},untagged")
  elif [[ -n "$ARG_SKIP" ]]; then
    args+=("--skip-tags" "$ARG_SKIP")
  fi

  echo -e "${I_OK}onesetup ==> Using Ansible Playbook from: ${C_CYAN}${X_TARGET_DIR}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Config file: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Inventory file: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Mode: ${C_CYAN}${SUBCMD}${C_RESET}"

  ansible-playbook "$playbook" "${args[@]}" || {
    echo -e "${I_ERR}onesetup ==> ansible playbook failed"
    exit 1
  }
  echo -e "${I_OK}onesetup ==> ansible playbook finished"
}

# Call Main Function with args
main "$@"
