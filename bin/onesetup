#!/usr/bin/env bash

# --                         -- #
# --     ONESETUP BINARY     -- #
# --                         -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup'

# -- GLOBALS -- #
SUBCMD=""        # run | test | help | "" (empty → interactive prompt)
ARG_INCLUDE=""   # --include <module[.submodule],...>
ARG_SKIP=""      # --skip <module[.submodule],...>
ARG_DEV_DIR=""   # --dev-dir <path>
ARG_DIFF="false" # --diff (test only)

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [3] Setup (dependencies, target dir)
  setup

  # [4] Ask for the subcommand if none was given
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    if [[ -z "$SUBCMD" ]]; then
      log_warn "Operation cancelled."
      exit 0
    fi
    validate_args
  fi

  # [5] Run
  run_playbook
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    exit 1
  }
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD & ARG_*, no side effects)
function parse_args() {
  # Optional subcommand as first argument
  case "${1:-}" in
  run | test)
    SUBCMD="$1"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (options still allowed)
  *)
    print_help >&2
    log_err "Unknown command: $1"
    exit 1
    ;;
  esac

  # Options
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --include)
      require_value "$1" "${2:-}"
      ARG_INCLUDE="$2"
      shift 2
      ;;
    --skip)
      require_value "$1" "${2:-}"
      ARG_SKIP="$2"
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    --diff)
      ARG_DIFF="true"
      shift
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    *)
      # shellcheck disable=SC2016 # false positive: expands inside the double quotes
      log_err "Unknown option${SUBCMD:+ for '${SUBCMD}'}: $1"
      exit 1
      ;;
    esac
  done

  validate_args
}

# Validate option combinations (called again after the interactive prompt)
function validate_args() {
  if [[ "$SUBCMD" == "run" && "$ARG_DIFF" == "true" ]]; then
    log_err "Flag '--diff' is only valid for 'test'."
    exit 1
  fi
  if [[ -n "$ARG_INCLUDE" && -n "$ARG_SKIP" ]]; then
    log_err "Use either '--include' or '--skip', not both."
    exit 1
  fi
  # Module names are validated by the playbook; only keep the value safe to pass on here
  if [[ ! "${ARG_INCLUDE}${ARG_SKIP}" =~ ^[a-z0-9_.,\ ]*$ ]]; then
    log_err "Invalid module list: '${ARG_INCLUDE}${ARG_SKIP}' (example: --skip apps.autostart,settings)"
    exit 1
  fi
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  run                         Run the Ansible playbook
  test                        Test the playbook without applying changes (--check)
  help, --help, -h            Display this help message
  (none)                      Choose a command interactively

Options:
  --include <module,...>      Only run these modules (e.g. apps,settings.dock)
  --skip <module,...>         Skip these modules (e.g. apps.autostart)
  --dev-dir <path>            Use a local project directory instead of the installed one
  --diff                      Show content diffs (only with 'test')

Configuration:
  Config file:                ${ONESETUP_CONFIG}
  Device settings:            ONESETUP_* environment variables (see README)
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to run the playbook
function setup() {
  # gum is only needed for the interactive prompt
  if [[ -z "$SUBCMD" ]]; then
    install_deps "ansible" "gum" "yq"
  else
    install_deps "ansible" "yq"
  fi

  use_dev_dir "$ARG_DEV_DIR"

  # Password manager references → values (ONESETUP_SSH_PASS, ONESETUP_VAULT_PASS, config 'secrets:')
  load_secrets
}

# --             -- #
# --     RUN     -- #
# --             -- #

# Ask for the subcommand (prints "run", "test" or nothing if canceled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Run Playbook" "Test Playbook")" in
  "Run Playbook") echo "run" ;;
  "Test Playbook") echo "test" ;;
  esac
}

# Build the ansible-playbook arguments from SUBCMD & ARG_* and run the playbook
function run_playbook() {
  local playbook="${X_TARGET_DIR}/main.yml"
  local args=("--ask-vault-pass")
  local vault_pass="$ONESETUP_VAULT_PASS"
  unset ONESETUP_VAULT_PASS # keep it out of the playbook's environment

  [[ -f "$playbook" && -r "$playbook" ]] || {
    log_err "No readable Playbook Entrypoint found at: ${C_CYAN}${playbook}${C_RESET}"
    exit 1
  }
  [[ -f "$ONESETUP_CONFIG" && -r "$ONESETUP_CONFIG" ]] || {
    log_err "No readable config file found at: ${C_CYAN}${ONESETUP_CONFIG}${C_RESET}"
    log_info "Run 'onesetup-init' to create it, or point ONESETUP_CONFIG to your config file."
    exit 1
  }

  # ONESETUP_DEBUG=<n> → -v repeated n times
  if [[ "$ONESETUP_DEBUG" -gt 0 ]]; then
    args+=("-$(printf 'v%.0s' $(seq "$ONESETUP_DEBUG"))")
  fi

  # 'test' → dry run (+ optional diffs)
  if [[ "$SUBCMD" == "test" ]]; then
    args+=("--check")
    if [[ "$ARG_DIFF" == "true" ]]; then
      args+=("--diff")
    fi
  fi

  # Module filters (applied to the 'modules' list of the config file)
  args+=("-e" "onesetup_include=${ARG_INCLUDE// /}" "-e" "onesetup_skip=${ARG_SKIP// /}")

  log_ok "onesetup ==> Using Ansible Playbook from: ${C_CYAN}${X_TARGET_DIR}${C_RESET}"
  log_info "onesetup ==> Config file: ${C_CYAN}${ONESETUP_CONFIG}${C_RESET}${ONESETUP_PROFILE:+ (profile: ${ONESETUP_PROFILE})}"
  log_info "onesetup ==> Ansible Config file: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}"
  log_info "onesetup ==> Ansible Inventory file: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}"
  log_info "onesetup ==> Mode: ${C_CYAN}${SUBCMD}${C_RESET}"

  # Vault password: ONESETUP_VAULT_PASS through a pipe (/dev/fd/N: not in argv, no temp file), else prompted
  # (the process substitution must be part of the command itself, its fd is closed afterwards)
  if [[ -n "$vault_pass" ]]; then
    ansible-playbook "$playbook" --vault-id "onesetup@"<(printf '%s\n' "$vault_pass") "${args[@]:1}"
  else
    ansible-playbook "$playbook" "${args[@]}"
  fi || {
    log_err "onesetup ==> ansible playbook failed"
    exit 1
  }
  log_ok "onesetup ==> ansible playbook finished"
}

# Call Main Function with args
main "$@"
