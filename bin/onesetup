# [2] Dependency Installation
function install_deps() {
  local os pkg_list
  os="$(detect_os)"
  pkg_list=("gum" "ansible")

  for pkg in "${pkg_list[@]}"; do
    if command -v "$pkg" &>/dev/null; then
      continue
    fi

    echo -e "${I_INFO}Dependency missing: ${C_RED}$pkg${C_RESET}. Installing..." >&2

    case "$os" in
    macos)
      if ! command -v "brew" &>/dev/null; then
        echo -e "${I_ERR}Homebrew is not installed on your system. Please install & re-run this script." >&2
        echo -e "${I_INFO}Install Homebrew from: ${C_BLUE}https://brew.sh${C_RESET}" >&2
        exit 1
      fi
      brew install "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg" >&2; exit 1; }
      ;;
    linux)
      install_linux_pkg "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg" >&2; exit 1; }
      ;;
    windows)
      echo -e "${I_ERR}Windows Support Coming soon.." >&2 && exit 1
      ;;
    *)
      echo -e "${I_ERR}Unsupported OS." >&2 && exit 1
      ;;
    esac
  done
}

# [3] Command Arguments Parser
function parse_args() {
  if [[ $# -eq 0 ]]; then
    prompt_subcommand
    return 0
  fi

  case "${1:-}" in
  run)
    shift
    run_playbook "$@"
    ;;
  tbd)
    shift
    cmd_tbd "$@"
    ;;
  help | --help | -h)
    print_help
    ;;
  *)
    echo -e "${I_ERR}Unknown command: $1" >&2
    print_help
    exit 1
    ;;
  esac
}

# --                              -- #
# --     SUBCOMMAND FUNCTIONS     -- #
# --                              -- #

# Subcommand: 'help': Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Sub-Commands:
  run                         Run Ansible Playbook
    --directory [dev/prod]    Ansible Playbook Directory: Git repo root (dev) or Installation Directory (prod). Default: prod
    --roles <role1,role2>     Comma-separated list of roles/tags to run
    --skip-roles <role1,...>  Comma-separated list of roles/tags to skip
  tbd                         To Be Defined
    --arg1                    Placeholder arg1
    --arg2                    Placeholder arg2
  help, --help, -h            Display this help message
EOF
}

# Subcommand 'run': Run Ansible Playbook
function run_playbook() {
  local roles=""
  local skip_roles=""
  local dir_type="prod"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --directory)
      if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
        echo -e "${I_ERR}Flag '--directory' requires a value: 'dev' or 'prod'." >&2
        exit 1
      fi
      dir_type="$2"
      shift 2
      ;;
    --directory=*)
      dir_type="${1#*=}"
      shift
      ;;
    --roles)
      if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
        echo -e "${I_ERR}Flag '--roles' requires a comma-separated list of roles." >&2
        exit 1
      fi
      roles="$2"
      shift 2
      ;;
    --skip-roles)
      if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
        echo -e "${I_ERR}Flag '--skip-roles' requires a comma-separated list of roles." >&2
        exit 1
      fi
      skip_roles="$2"
      shift 2
      ;;
    *)
      echo -e "${I_ERR}Unknown option for 'run': $1" >&2
      exit 1
      ;;
    esac
  done

  # Validate --directory value
  if [[ "$dir_type" != "dev" && "$dir_type" != "prod" ]]; then
    echo -e "${I_ERR}Invalid value '$dir_type' for '--directory'. Allowed values are 'dev' or 'prod'." >&2
    exit 1
  fi

  # Mutual Exclusion Checks for roles
  if [[ -n "$roles" && -n "$skip_roles" ]]; then
    echo -e "${I_ERR}Cannot specify both '--roles' and '--skip-roles' at the same time." >&2
    exit 1
  fi

  # Determine target working directory based on selected directory type
  local target_dir
  if [[ "$dir_type" == "dev" ]]; then
    if [[ -z "$ONESETUP_DIR_DEV" ]]; then
      echo -e "${I_ERR}'--directory dev' requested, but ONESETUP_DIR_DEV is not set and current directory is not a Git repository." >&2
      exit 1
    fi
    target_dir="$ONESETUP_DIR_DEV"
  else
    target_dir="$ONESETUP_DIR"
  fi

  # Export Ansible Environment Variables based on $target_dir
  export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-${target_dir}/ansible.cfg}"
  export ANSIBLE_INVENTORY="${ANSIBLE_INVENTORY:-${target_dir}/inventory.ini}"

  # Initialize Homebrew on macOS if available
  if [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -f "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  echo -e "${I_OK} onesetup ==> running ansible playbook from: ${C_CYAN}${target_dir}${C_RESET}"

  # Construct Ansible playbook arguments dynamically
  local ansible_args=("--ask-vault-pass")

  if [[ -n "$roles" ]]; then
    ansible_args+=("--tags" "$roles")
  elif [[ -n "$skip_roles" ]]; then
    ansible_args+=("--skip-tags" "$skip_roles")
  fi

  if ansible-playbook "${target_dir}/main.yml" "${ansible_args[@]}"; then
    echo -e "${I_OK} onesetup ==> ansible playbook finished"
  else
    echo -e "${I_ERR} onesetup ==> ansible playbook failed" >&2
    exit 1
  fi
}

# Subcommand 'tbd': To Be Defined
function cmd_tbd() {
  echo -e "${I_INFO}Coming Soon.."
}

# Prompt for Subcommand when run without arguments
function prompt_subcommand() {
  local choice
  choice=$(
    gum choose "Run Playbook" "TBD" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )

  case "$choice" in
  "Run Playbook") run_playbook ;;
  "TBD") cmd_tbd ;;
  *) echo -e "${I_WARN}Operation cancelled." ;;
  esac
}

# Call Main Function with args
main "$@"
