#!/usr/bin/env bash

# --                         -- #
# --     ONESETUP BINARY     -- #
# --                         -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup'

# [0] Main Function
function main() {
  # Function Calls
  load_utils
  tty_styles || echo -e "${I_WARN}Failed to load TTY Styles."
  set_modes || echo -e "${I_WARN}Failed to set Script Modes."
  init_brew || echo -e "${I_WARN}Failed to initialize Homebrew"
  { read_config && echo -e "${I_OK}Config File read"; } || { echo -e "${I_ERR}Failed to read Config File"; exit 1; }
  export_dynamic_vars || { echo -e "${I_ERR}Failed to export Dynamic Environment Variables!"; exit 1; }
  install_deps || { echo -e "${I_ERR}Failed to install dependencies"; exit 1; }
  parse_args "$@" || { echo -e "${I_ERR}Failed to parse Command arguments"; exit 1; }
}

# [1] Source Utility Script
function load_utils(){
  local system_install_dir="$HOME/.local/share/onesetup" # TODO: Implement support for customized installation directory
  source "${system_install_dir}/scripts/util.sh" && echo -e "${I_OK}Utility Script sourced" || { echo -e "${I_ERR}Failed to source Utility Script"; exit 1; }
}

# [2] Dependency Installation
function install_deps() {
  local os pkg_list
  os="$(detect_os)"
  pkg_list=("gum" "ansible")

  for pkg in "${pkg_list[@]}"; do
    if command -v "$pkg" &>/dev/null; then
      continue
    fi

    echo -e "${I_INFO}Dependency missing: ${C_RED}$pkg${C_RESET}. Installing..." >&2

    case "$os" in
    osx)
      if ! command -v "brew" &>/dev/null; then
        echo -e "${I_ERR}Homebrew is not installed on your system. Please install & re-run this script." >&2
        echo -e "${I_INFO}Install Homebrew from: ${C_BLUE}https://brew.sh${C_RESET}" >&2
        exit 1
      fi
      brew install "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg" >&2; exit 1; }
      ;;
    linux)
      install_linux_pkg "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg" >&2; exit 1; }
      ;;
    windows)
      echo -e "${I_ERR}Windows Support Coming soon.." >&2 && exit 1
      ;;
    *)
      echo -e "${I_ERR}Unsupported OS." >&2 && exit 1
      ;;
    esac
  done
}

# [3] Command Arguments Parser
function parse_args() {
  if [[ $# -eq 0 ]]; then
    prompt_subcommand
    return 0
  fi

  case "${1:-}" in
  run)
    shift
    run_playbook "$@"
    ;;
  test)
    shift
    test_playbook "$@"
    ;;
  help | --help | -h)
    print_help
    ;;
  *)
    echo -e "${I_ERR}Unknown command: $1" >&2
    print_help
    exit 1
    ;;
  esac
}

ARG_ROLES=""
ARG_SKIP_ROLES=""
ARG_DEV_DIR=""
ARG_DIFF="false"

# Ensure a flag has a value: require_value <flag> <value>
function require_value() {
  if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
    echo -e "${I_ERR}Flag '$1' requires a value." >&2
    exit 1
  fi
}

# Resolve Target Dir based on dev_dir & install_dir
function resolve_target_dir() {
  local dir source

  if [[ -n "$OPT_DEV_DIR" ]]; then
    dir="$OPT_DEV_DIR" source="--dev-dir"
  elif [[ -n "${ONESETUP_PROJECT_DEV_DIR:-}" ]]; then
    dir="$ONESETUP_PROJECT_DEV_DIR" source="ONESETUP_PROJECT_DEV_DIR"
  else
    dir="${ONESETUP_SYSTEM_INSTALL_DIR:-}" source="ONESETUP_SYSTEM_INSTALL_DIR"
  fi

  if [[ -z "$dir" ]]; then
    echo -e "${I_ERR}Target directory is empty. Is ${C_CYAN}${source}${C_RESET} set?" >&2
    exit 1
  elif [[ ! -d "$dir" ]]; then
    echo -e "${I_ERR}Target directory (from ${source}) does not exist: ${C_CYAN}${dir}${C_RESET}" >&2
    exit 1
  fi

  TARGET_DIR="$(cd "$dir" && pwd -P)"
  [[ "$source" != "ONESETUP_SYSTEM_INSTALL_DIR" ]] &&
    echo -e "${I_INFO}onesetup ==> Using dev directory (via ${source})"
}

# Parse Playbook arguments [used by run_playbook() & test_playbook()]
function parse_playbook_args() {
  local subcmd="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --roles)
      require_value "$1" "${2:-}"
      ARG_ROLES="$2"
      shift 2
      ;;
    --skip-roles)
      require_value "$1" "${2:-}"
      ARG_SKIP_ROLES="$2"
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    --diff)
      if [[ "$subcmd" != "test" ]]; then
        echo -e "${I_ERR}Flag '--diff' is only valid for 'test'." >&2
        exit 1
      fi
      ARG_DIFF=true
      shift
      ;;
    *)
      echo -e "${I_ERR}Unknown option for '${subcmd}': $1" >&2
      exit 1
      ;;
    esac
  done
}

# Validate & Execute the Ansible Playbook
# called by run_playbook() & test_playbook()
function exec_playbook() {
  resolve_target_dir # Get $TARGET_DIR Value
  
  local entrypoint="${TARGET_DIR}/main.yml" # Playbook Entrypoint (main.yml)
  local ansible_args=("--ask-vault-pass" "$@") # Playbook Arguments (+passed in exec_playbook call)
  
  # Check if main.yml exists in target_dir
  if [[ ! -f "$entrypoint" || ! -r "$entrypoint" ]]; then
    echo -e "${I_ERR}No readable Playbook Entrypoint found at: ${C_CYAN}${entrypoint}${C_RESET}" >&2
    exit 1
  fi
  
  # Export & Validate Ansible Env-Vars
  export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-${TARGET_DIR}/ansible.cfg}"
  export ANSIBLE_INVENTORY="${ANSIBLE_INVENTORY:-${TARGET_DIR}/inventory.ini}"
  [[ -f "$ANSIBLE_CONFIG" ]]    || echo -e "${I_WARN}Ansible config not found: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}" >&2
  [[ -f "$ANSIBLE_INVENTORY" ]] || echo -e "${I_WARN}Ansible inventory not found: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}" >&2 

  # Display Messages
  echo -e "${I_OK}onesetup ==> Using Ansible Playbook from: ${C_CYAN}${TARGET_DIR}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Config file: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Inventory file: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}"
  
  # Add --tags or --skip-tags to ansible_args
  if [[ -n "$OPT_ROLES" ]]; then
    ansible_args+=("--tags" "${OPT_ROLES},untagged")
  elif [[ -n "$OPT_SKIP_ROLES" ]]; then
    ansible_args+=("--skip-tags" "$OPT_SKIP_ROLES")
  fi
  
  # Run Playbook with Entrypoint & Args set before
  if ansible-playbook "$entrypoint" "${ansible_args[@]}"; then
    echo -e "${I_OK}onesetup ==> ansible playbook finished"
  else
    echo -e "${I_ERR}onesetup ==> ansible playbook failed" >&2
    exit 1
  fi
}

# --                              -- #
# --     SUBCOMMAND FUNCTIONS     -- #
# --                              -- #

# Subcommand: 'help': Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Sub-Commands:
  run                         Run Ansible Playbook
    --roles <role1,role2>     Comma-separated list of roles/tags to run
    --skip-roles <role1,...>  Comma-separated list of roles/tags to skip
  test                        Test Playbook Changes without applying them
    --diff                    Show the Content diffs for modules like copy/lineinfile/..
  help, --help, -h            Display this help message
EOF
}

# Subcommand 'run': Run Ansible Playbook
function run_playbook() {
  parse_playbook_args run "$@"
  exec_playbook
}

# Subcommand: 'test': Test Playbook Changes without applying them
function test_playbook() {
  parse_playbook_args test "$@"
  local args=("--check")
  if [[ "$OPT_DIFF" == true ]]; then
    args+=("--diff")
  fi
  exec_playbook "${args[@]}"
}

# Prompt for Subcommand when run without arguments
function prompt_subcommand() {
  local choice
  choice=$(
    gum choose "Run Playbook" "Test Playbook" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )

  case "$choice" in
  "Run Playbook") run_playbook ;;
  "Test Playbook") test_playbook ;;
  *) echo -e "${I_WARN}Operation cancelled." ;;
  esac
}

# Call Main Function with args
main "$@"
