#!/usr/bin/env bash

# --                         -- #
# --     ONESETUP BINARY     -- #
# --                         -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup'

# -- GLOBALS -- #
SUBCMD=""        # run | test | help | "" (empty → interactive prompt)
ARG_INCLUDE=""   # --include <tags>
ARG_SKIP=""      # --skip <tags>
ARG_DEV_DIR=""   # --dev-dir <path>
ARG_DIFF="false" # --diff (test only)
TARGET_DIR=""    # Project directory (set by resolve_target_dir)

# -- HELPERS -- #
# Print an error & exit
function die() {
  echo -e "${I_ERR:-[ERROR] }$*" >&2
  exit 1
}

# Print a warning
function warn() {
  echo -e "${I_WARN:-[WARN] }$*" >&2
}

# -- MAIN -- #
function main() {
  # [1] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [2] Setup (utils, config, dependencies)
  setup

  # [3] Ask for the subcommand if none was given
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    if [[ -z "$SUBCMD" ]]; then
      warn "Operation cancelled."
      exit 0
    fi
  fi

  # [4] Run
  run_playbook
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD & ARG_*, no side effects)
function parse_args() {
  # Optional subcommand as first argument
  case "${1:-}" in
  run | test)
    SUBCMD="$1"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (options still allowed)
  *)
    print_help >&2
    die "Unknown command: $1"
    ;;
  esac

  # Options
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --include)
      require_value "$1" "${2:-}"
      ARG_INCLUDE="$2"
      shift 2
      ;;
    --skip)
      require_value "$1" "${2:-}"
      ARG_SKIP="$2"
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    --diff)
      if [[ "$SUBCMD" == "run" ]]; then
        die "Flag '--diff' is only valid for 'test'."
      fi
      ARG_DIFF="true"
      shift
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    *)
      # shellcheck disable=SC2016 # false positive: expands inside the double quotes
      die "Unknown option${SUBCMD:+ for '${SUBCMD}'}: $1"
      ;;
    esac
  done

  if [[ -n "$ARG_INCLUDE" && -n "$ARG_SKIP" ]]; then
    die "Use either '--include' or '--skip', not both."
  fi
}

# Ensure a flag has a value: require_value <flag> <value>
function require_value() {
  if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
    die "Flag '$1' requires a value."
  fi
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  run                         Run the Ansible playbook
  test                        Test the playbook without applying changes (--check)
  help, --help, -h            Display this help message
  (none)                      Choose a command interactively

Options:
  --include <tag1,tag2>       Only run these roles/tags
  --skip <tag1,tag2>          Skip these roles/tags
  --dev-dir <path>            Use a local project directory instead of the installed one
  --diff                      Show content diffs (only with 'test')
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to run the playbook
function setup() {
  resolve_target_dir
  load_utils
  tty_styles || warn "Failed to load TTY Styles."
  set_modes || warn "Failed to set Script Modes."
  init_brew || warn "Failed to initialize Homebrew."
  read_config || die "Failed to read Config File."
  export_dynamic_vars || die "Failed to export Dynamic Environment Variables."
  resolve_target_dir # Re-resolve: the config may set ONESETUP_PROJECT_DEV_DIR / ONESETUP_SYSTEM_INSTALL_DIR
  install_deps
}

# Set TARGET_DIR: --dev-dir > ONESETUP_PROJECT_DEV_DIR > ONESETUP_SYSTEM_INSTALL_DIR > default
function resolve_target_dir() {
  local default_dir="$HOME/.local/share/onesetup"
  local dir="${ARG_DEV_DIR:-${ONESETUP_PROJECT_DEV_DIR:-${ONESETUP_SYSTEM_INSTALL_DIR:-$default_dir}}}"

  [[ -d "$dir" ]] || die "Target directory does not exist: ${C_CYAN:-}${dir}${C_RESET:-}"

  TARGET_DIR="$(CDPATH='' cd -- "$dir" && pwd -P)"
  export ONESETUP_SYSTEM_TARGET_DIR="$TARGET_DIR" # used by Ansible
}

# Source the Utility Script from TARGET_DIR
function load_utils() {
  local util_script="${TARGET_DIR}/scripts/util.sh"

  [[ -r "$util_script" ]] || die "Utility Script not found: ${util_script}"
  # shellcheck source=/dev/null
  source "$util_script" || die "Failed to source Utility Script: ${util_script}"
}

# Install missing dependencies
function install_deps() {
  local os pkg
  local pkgs=("ansible")

  # gum is only needed for the interactive prompt
  if [[ -z "$SUBCMD" ]]; then
    pkgs+=("gum")
  fi

  os="$(detect_os)"

  for pkg in "${pkgs[@]}"; do
    if command -v "$pkg" &>/dev/null; then
      continue
    fi

    echo -e "${I_INFO}Dependency missing: ${C_RED}${pkg}${C_RESET}. Installing..." >&2

    case "$os" in
    osx)
      command -v brew &>/dev/null ||
        die "Homebrew is not installed. Install it from ${C_BLUE}https://brew.sh${C_RESET} & re-run this script."
      brew install "$pkg" || die "Failed to install: ${pkg}"
      ;;
    linux)
      install_linux_pkg "$pkg" || die "Failed to install: ${pkg}"
      ;;
    windows)
      die "Windows support coming soon."
      ;;
    *)
      die "Unsupported OS: ${os}"
      ;;
    esac
  done
}

# --             -- #
# --     RUN     -- #
# --             -- #

# Ask for the subcommand (prints "run", "test" or nothing if canceled)
function prompt_subcommand() {
  local choice
  choice="$(
    gum choose "Run Playbook" "Test Playbook" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )"

  case "$choice" in
  "Run Playbook") echo "run" ;;
  "Test Playbook") echo "test" ;;
  esac
}

# Build the ansible-playbook arguments from SUBCMD & ARG_* and run the playbook
function run_playbook() {
  local playbook="${TARGET_DIR}/main.yml"
  local args=("--ask-vault-pass")

  [[ -f "$playbook" && -r "$playbook" ]] ||
    die "No readable Playbook Entrypoint found at: ${C_CYAN}${playbook}${C_RESET}"

  # Ansible config & inventory (values already set in the environment win)
  export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-${TARGET_DIR}/ansible.cfg}"
  export ANSIBLE_INVENTORY="${ANSIBLE_INVENTORY:-${TARGET_DIR}/inventory.ini}"
  [[ -f "$ANSIBLE_CONFIG" ]] || warn "Ansible config not found: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}"
  [[ -f "$ANSIBLE_INVENTORY" ]] || warn "Ansible inventory not found: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}"

  # 'test' → dry run (+ optional diffs)
  if [[ "$SUBCMD" == "test" ]]; then
    args+=("--check")
    if [[ "$ARG_DIFF" == "true" ]]; then
      args+=("--diff")
    fi
  fi

  # Tag filters
  if [[ -n "$ARG_INCLUDE" ]]; then
    args+=("--tags" "${ARG_INCLUDE},untagged")
  elif [[ -n "$ARG_SKIP" ]]; then
    args+=("--skip-tags" "$ARG_SKIP")
  fi

  echo -e "${I_OK}onesetup ==> Using Ansible Playbook from: ${C_CYAN}${TARGET_DIR}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Config file: ${C_CYAN}${ANSIBLE_CONFIG}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Ansible Inventory file: ${C_CYAN}${ANSIBLE_INVENTORY}${C_RESET}"
  echo -e "${I_INFO}onesetup ==> Mode: ${C_CYAN}${SUBCMD}${C_RESET}"

  ansible-playbook "$playbook" "${args[@]}" || die "onesetup ==> ansible playbook failed"
  echo -e "${I_OK}onesetup ==> ansible playbook finished"
}

# Call Main Function with args
main "$@"
