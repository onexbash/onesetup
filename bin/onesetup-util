#!/usr/bin/env bash

# --                              -- #
# --     ONESETUP-UTIL BINARY     -- #
# --                              -- #
# Sourced by onesetup, onesetup-init & onesetup-vault (not meant to be executed directly)

# Main Function (Calls Functions that should always be called)
function main() {
  tty_styles || echo -e "${I_WARN:-[ERR] }Failed to Call tty_styles()"
  set_modes || echo -e "${I_WARN:-[ERR] }Failed to Call set_modes()"
  init_brew || echo -e "${I_WARN:-[ERR] }Failed to Call init_brew()"
  apply_config || echo -e "${I_WARN:-[ERR] }Failed to Call apply_config()"
}

# --                    -- #
# --     SHELL SETUP    -- #
# --                    -- #

# [UTIL] Terminal Colors & Prompts
function tty_styles() {
  # Terminal Colors
  export C_BLACK='\033[1;30m'
  export C_RED='\033[1;31m'
  export C_GREEN='\033[1;32m'
  export C_YELLOW='\033[1;33m'
  export C_BLUE='\033[1;34m'
  export C_PURPLE='\033[1;35m'
  export C_CYAN='\033[1;36m'
  export C_WHITE='\033[1;37m'
  export C_GRAY='\033[1;34m'
  export C_RESET='\033[0m'
  # Accent color for gum prompts (ANSI 6 = cyan), overridable via env
  export GUM_COLOR="${GUM_COLOR:-6}"
  # Info Prompts
  export I_SKIP="${C_BLACK}[${C_CYAN} SKIPPING ${C_BLACK}] ${C_RESET}"   # skipping
  export I_WARN="${C_BLACK}[${C_YELLOW} WARNING ${C_BLACK}] ${C_RESET}"  # warning
  export I_OK="${C_BLACK}[${C_GREEN}  OK  ${C_BLACK}] ${C_RESET}"        # ok
  export I_INFO="${C_BLACK}[${C_PURPLE} INFO ${C_BLACK}] ${C_RESET}"     # info
  export I_ERR="${C_BLACK}[${C_RED} ERROR ${C_BLACK}] ${C_RESET}"        # error
  export I_YN="${C_BLACK}[${C_BLUE} y/n ${C_BLACK}] ${C_RESET}"          # ask user for yes/no
  export I_ASK="${C_BLACK}[${C_BLUE} ? ${C_BLACK}] ${C_RESET}"           # ask user for anything
  export I_LOAD="${C_BLACK}[${C_BLUE} LOADING .. ${C_BLACK}] ${C_RESET}" # loading
}

# [UTIL] Set Script Modes (ONESETUP_DEBUG: 0-4, 4 also traces these scripts)
function set_modes() {
  set -eo pipefail
  [[ "${ONESETUP_DEBUG:-0}" =~ ^[0-4]$ ]] || {
    echo -e "${I_ERR}ONESETUP_DEBUG must be a number from 0 to 4 (got: '${ONESETUP_DEBUG}')"
    exit 1
  }
  if [[ "${ONESETUP_DEBUG:-0}" -eq 4 ]]; then
    set -x
    echo -e "${I_OK}Running Script in Debug Mode"
  fi
}

# --                -- #
# --     SYSTEM     -- #
# --                -- #

# [UTIL] Detect Operating System
function detect_os() {
  local platform
  platform=$(uname -s)
  case "$platform" in
  Linux*) echo "linux" ;;
  Darwin*) echo "osx" ;;
  CYGWIN* | MINGW* | MSYS*) echo "windows" ;;
  *) echo "unsupported" ;;
  esac
}

# [UTIL] Initialize Homebrew on MacOS if installed but not available (missing PATH)
function init_brew() {
  local os
  os="$(detect_os)"
  if [[ "$os" == "osx" ]] && ! command -v brew >/dev/null 2>&1; then
    if [[ -x "/opt/homebrew/bin/brew" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"
    elif [[ -x "/usr/local/bin/brew" ]]; then
      eval "$(/usr/local/bin/brew shellenv 2>/dev/null)"
    fi
  fi
  return 0
}

# [UTIL] Linux PKG Installer
function install_linux_pkg() {
  local pkg="$1"
  if command -v apt-get &>/dev/null; then
    sudo apt-get update -qq && sudo apt-get install -y "$pkg"
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y "$pkg"
  elif command -v pacman &>/dev/null; then
    sudo pacman -S --noconfirm "$pkg"
  else
    echo -e "${I_ERR}Unsupported package manager." >&2
    return 1
  fi
}

# [UTIL] Install a package with the platform's package manager: install_pkg <pkg> [os]
function install_pkg() {
  local pkg="$1" os="${2:-$(detect_os)}"
  case "$os" in
  osx) brew install "$pkg" ;;
  linux) install_linux_pkg "$pkg" ;;
  windows) {
    echo -e "${I_ERR}Windows not supported yet"
    return 1
  } ;;
  *) {
    echo -e "${I_ERR}Unsupported Operating System: ${os}"
    return 1
  } ;;
  esac
}

# [UTIL] Install missing commands & exit on failure: install_deps <cmd...>
function install_deps() {
  local pkg
  for pkg in "$@"; do
    command -v "$pkg" &>/dev/null && continue
    echo -e "${I_INFO}Installing missing dependency: ${C_CYAN}${pkg}${C_RESET}"
    install_pkg "$pkg" || {
      echo -e "${I_ERR}Installation failed: ${pkg}"
      exit 1
    }
    echo -e "${I_OK}Installation succeeded: ${pkg}"
  done
}

# --                     -- #
# --     FILESYSTEM      -- #
# --                     -- #

# [UTIL] Check if a Directory is sudo-writable or protected with MacOS System Integrity Protection
# Returns 0 = writable, 1 = not writable (SIP, read-only mount, ACL, ...), 2 = does not exist
function is_writable() {
  local dir="$1"
  local test_file

  if [[ ! -d "$dir" ]]; then
    echo -e "${I_ERR}Directory does not exist: $dir"
    return 2
  fi

  test_file="${dir}/.onesetup_write_test_$$"

  if sudo touch "$test_file" &>/dev/null; then
    sudo rm -f "$test_file" &>/dev/null
    return 0
  else
    return 1
  fi
}

# [UTIL] Ensure Directory presence with right permissions & ownership
# ensure_directory <dir> <perms> <user:group> [recursive=false]
function ensure_directory() {
  local target_dir="$1" desired_perms="$2" desired_ownership="$3" recursive="${4:-false}"
  local chown_args=()
  local current_owner current_perms

  if [[ "$recursive" == "true" ]]; then
    chown_args=("-R")
  fi

  # Create Directory & set permissions if not present yet
  if [[ ! -d "$target_dir" ]]; then
    sudo mkdir -p "$target_dir"
    sudo chown "${chown_args[@]}" "$desired_ownership" "$target_dir"
    sudo chmod "$desired_perms" "$target_dir"
    return 0
  fi

  # Read current ownership & permissions of the existing Directory
  if [[ "$(detect_os)" == "osx" ]]; then
    current_owner=$(/usr/bin/stat -f "%Su:%Sg" "$target_dir")
    current_perms=$(/usr/bin/stat -f "%Lp" "$target_dir")
  else
    current_owner=$(stat -c "%U:%G" "$target_dir")
    current_perms=$(stat -c "%a" "$target_dir")
  fi

  # Fix them only where they differ (if-blocks: an unchanged directory must still return 0)
  if [[ "$current_owner" != "$desired_ownership" ]]; then
    sudo chown "${chown_args[@]}" "$desired_ownership" "$target_dir"
  fi
  if [[ "$current_perms" != "$desired_perms" ]]; then
    sudo chmod "$desired_perms" "$target_dir"
  fi
  return 0
}

# [UTIL] Copy stdin to the clipboard (prints it if no clipboard tool is available)
function copy_to_clipboard() {
  if command -v pbcopy &>/dev/null; then
    pbcopy
  elif command -v wl-copy &>/dev/null; then
    wl-copy
  elif command -v xclip &>/dev/null; then
    xclip -selection clipboard 2>/dev/null
  else
    cat
    echo -e "\n${I_WARN}No clipboard tool found — printed above instead." >&2
  fi
}

# --                       -- #
# --     CLI & PROMPTS     -- #
# --                       -- #

# [UTIL] Ensure a command-line option received a value: require_value <option> <value>
function require_value() {
  if [[ -z "$2" || "$2" == --* ]]; then
    echo -e "${I_ERR}Option '$1' requires a value."
    exit 1
  fi
}

# [UTIL] Single-choice prompt (prints the selection or nothing if cancelled): choose <header> <option...>
function choose() {
  local header="$1"
  shift
  gum choose \
    --header "$header" \
    --cursor.foreground "$GUM_COLOR" \
    --header.foreground "$GUM_COLOR" \
    --selected.foreground "$GUM_COLOR" \
    "$@" || true
}

# --                    -- #
# --     PROJECT DIR    -- #
# --                    -- #

# [UTIL] Point the target dir & the Ansible paths to a project directory: set_target_dir <path>
function set_target_dir() {
  export X_TARGET_DIR="$1"
  export ANSIBLE_CONFIG="${X_TARGET_DIR}/ansible.cfg"
  export ANSIBLE_INVENTORY="${X_TARGET_DIR}/inventory.ini"
}

# [UTIL] Use a local project directory instead of the installed one: use_dev_dir [path]
# (no-op if path is empty, e.g. when '--dev-dir' was not given)
function use_dev_dir() {
  local dir="${1/#\~/$HOME}" # quoted "~/..." is not expanded by the shell
  [[ -n "$dir" ]] || return 0
  [[ -d "$dir" ]] || {
    echo -e "${I_ERR}Development directory not found: ${C_CYAN}$dir${C_RESET}"
    exit 1
  }
  ONESETUP_DEV_DIR="$(cd -P "$dir" && pwd)"
  export ONESETUP_DEV_DIR
  set_target_dir "$ONESETUP_DEV_DIR"
}

# --                -- #
# --     CONFIG     -- #
# --                -- #

# [UTIL] Export the device-specific settings (environment variables only, see README: Environment Variables)
# Everything else is configured in the config file ($ONESETUP_CONFIG) and read by the playbook.
function apply_config() {
  export ONESETUP_CONFIG="${ONESETUP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/onesetup/onesetup.yml}"
  export ONESETUP_PROFILE="${ONESETUP_PROFILE:-}"
  export ONESETUP_HOSTNAME="${ONESETUP_HOSTNAME:-}"
  export ONESETUP_INSTALL_DIR="${ONESETUP_INSTALL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/onesetup}"
  export ONESETUP_STATE_DIR="${ONESETUP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/onesetup}"
  export ONESETUP_BIN_DIR="${ONESETUP_BIN_DIR:-/usr/local/bin}"
  export ONESETUP_SSH_KEY="${ONESETUP_SSH_KEY:-}"
  export ONESETUP_SSH_PASS="${ONESETUP_SSH_PASS:-}"
  export ONESETUP_VAULT_PASS="${ONESETUP_VAULT_PASS:-}"
  export ONESETUP_KEEPASSXC_DB="${ONESETUP_KEEPASSXC_DB:-}"
  export ONESETUP_REPO="${ONESETUP_REPO:-https://github.com/onexbash/onesetup.git}"
  export ONESETUP_BRANCH="${ONESETUP_BRANCH:-main}"
  export ONESETUP_DEV_DIR="${ONESETUP_DEV_DIR:-}"
  export ONESETUP_DEBUG="${ONESETUP_DEBUG:-0}"

  # Quoted values ("~/...") are not expanded by the shell
  ONESETUP_CONFIG="${ONESETUP_CONFIG/#\~/$HOME}"
  ONESETUP_SSH_KEY="${ONESETUP_SSH_KEY/#\~/$HOME}"
  ONESETUP_KEEPASSXC_DB="${ONESETUP_KEEPASSXC_DB/#\~/$HOME}"
  ONESETUP_DEV_DIR="${ONESETUP_DEV_DIR/#\~/$HOME}"

  set_target_dir "${ONESETUP_DEV_DIR:-$ONESETUP_INSTALL_DIR}"
  export ANSIBLE_COLLECTIONS_PATH="${ONESETUP_STATE_DIR}/collections"
}

# --                 -- #
# --     SECRETS     -- #
# --                 -- #

# [UTIL] Print a secret: password manager references are resolved, other values printed as they are
# resolve_secret <value>
#   pass://<vault>/<item>/<field>          Proton Pass  (pass-cli, logged in)
#   keepassxc://<group/.../entry>/<attr>   KeePassXC    (keepassxc-cli, database: $ONESETUP_KEEPASSXC_DB)
#   bitwarden://<item>/<field>             Bitwarden    (bw, unlocked: $BW_SESSION)
function resolve_secret() {
  local ref="$1" path item field
  case "$ref" in
  pass://* | keepassxc://* | bitwarden://*) ;;
  *)
    printf '%s' "$ref"
    return 0
    ;;
  esac

  # The last path segment is the field, everything before it the item
  path="${ref#*://}"
  field="${path##*/}"
  item="${path%/*}"
  if [[ "$path" != */* || -z "$field" || -z "$item" ]]; then
    echo -e "${I_ERR}Invalid secret reference: ${ref} (expected <scheme>://<item>/<field>)" >&2
    return 1
  fi

  case "$ref" in
  pass://*)
    [[ "$item" == */* ]] || {
      echo -e "${I_ERR}Invalid Proton Pass reference: ${ref} (expected pass://<vault>/<item>/<field>)" >&2
      return 1
    }
    command -v pass-cli &>/dev/null || {
      echo -e "${I_ERR}pass-cli not found (needed for ${ref})" >&2
      return 1
    }
    pass-cli item view --vault-name "${item%%/*}" --item-title "${item#*/}" --field "$field"
    ;;
  keepassxc://*)
    [[ -f "$ONESETUP_KEEPASSXC_DB" ]] || {
      echo -e "${I_ERR}Set ONESETUP_KEEPASSXC_DB to your KeePassXC database (needed for ${ref})" >&2
      return 1
    }
    # The password prompt goes to the terminal, only the attribute value to stdout
    printf '%b' "${I_ASK}KeePassXC password for ${ONESETUP_KEEPASSXC_DB}: " >&2
    keepassxc-cli show --quiet --show-protected --attributes "$field" "$ONESETUP_KEEPASSXC_DB" "$item"
    echo >&2
    ;;
  bitwarden://*)
    command -v bw &>/dev/null || {
      echo -e "${I_ERR}bw (Bitwarden CLI) not found (needed for ${ref})" >&2
      return 1
    }
    # Login fields first, then custom fields with that name
    bw get item "$item" | FIELD="$field" yq -p json -r '
      (.login[strenv(FIELD)] // .[strenv(FIELD)] // (.fields[] | select(.name == strenv(FIELD)) | .value)) // ""'
    ;;
  esac
}

# [UTIL] Export secrets, with password manager references resolved: load_secrets [name...]
# Secrets: ONESETUP_SSH_PASS, ONESETUP_VAULT_PASS & every variable under 'secrets:' in the config file
# (only references there, never plain secrets). Environment variables win over the config file.
# With names given, only these are loaded.
function load_secrets() {
  local names=("$@") config_names=() name value
  local all=(ONESETUP_SSH_PASS ONESETUP_VAULT_PASS)

  if [[ -f "$ONESETUP_CONFIG" ]] && yq -e '.secrets' "$ONESETUP_CONFIG" &>/dev/null; then
    while IFS= read -r name; do
      config_names+=("$name")
    done < <(yq -r '.secrets | keys | .[]' "$ONESETUP_CONFIG")
  fi
  all+=("${config_names[@]}")
  [[ ${#names[@]} -gt 0 ]] || names=("${all[@]}")

  for name in "${names[@]}"; do
    [[ "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || {
      echo -e "${I_ERR}Invalid variable name under 'secrets:' in ${ONESETUP_CONFIG}: ${name}"
      exit 1
    }
    value="$(printenv "$name" || true)"
    if [[ -z "$value" && " ${config_names[*]} " == *" ${name} "* ]]; then
      value="$(NAME="$name" yq -r '.secrets[strenv(NAME)]' "$ONESETUP_CONFIG")"
      [[ "$value" =~ ^(pass|keepassxc|bitwarden):// ]] || {
        echo -e "${I_ERR}secrets.${name} in ${ONESETUP_CONFIG} must be a password manager reference (pass://, keepassxc://, bitwarden://), not a plain secret."
        exit 1
      }
    fi
    [[ -n "$value" ]] || continue
    value="$(resolve_secret "$value")" && [[ -n "$value" ]] || {
      echo -e "${I_ERR}Failed to resolve the secret for ${name} (missing or empty)"
      exit 1
    }
    export "${name}=${value}"
  done
}

# Call Main Function with Args
main "$@"

