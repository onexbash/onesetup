#!/usr/bin/env bash

# --                               -- #
# --     ONESETUP-VAULT BINARY     -- #
# --                               -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup-vault'

# -- GLOBALS -- #
SUBCMD=""      # encrypt | help | "" (empty → interactive prompt)
ACTION=""      # string | file | "" (empty → interactive prompt)
ARG_TARGET=""  # --target <clipboard|ansible> ("" → prompt, or clipboard without a terminal)
ARG_FILE=""    # --file [path]
ARG_VARNAME="" # --file [path] [varname]
ARG_DEV_DIR="" # --dev-dir <path>
VARFILE=""     # Vars file for target 'ansible' (set in setup)

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [3] Setup (dependencies, target dir)
  setup

  # [4] Ask for missing choices
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    case "$SUBCMD" in
    help)
      print_help
      exit 0
      ;;
    "")
      echo -e "${I_WARN}Operation cancelled."
      exit 0
      ;;
    esac
  fi
  if [[ -z "$ACTION" ]]; then
    ACTION="$(prompt_action)"
    if [[ -z "$ACTION" ]]; then
      echo -e "${I_WARN}Operation cancelled."
      exit 0
    fi
  fi

  # [5] Run
  case "$ACTION" in
  string) encrypt_string ;;
  file) encrypt_file ;;
  esac
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    exit 1
  }
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD, ACTION & ARG_*, no side effects)
function parse_args() {
  local positional=()

  # Optional subcommand as first argument
  case "${1:-}" in
  encrypt)
    SUBCMD="encrypt"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (--dev-dir still allowed)
  *)
    print_help >&2
    echo -e "${I_ERR}Unknown command: $1"
    exit 1
    ;;
  esac

  # Options & positional arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --string | --file)
      if [[ -n "$ACTION" ]]; then
        echo -e "${I_ERR}Cannot specify both '--string' and '--file'."
        exit 1
      fi
      ACTION="${1#--}"
      shift
      ;;
    --target)
      require_value "$1" "${2:-}"
      case "$2" in
      clipboard | ansible) ARG_TARGET="$2" ;;
      *) {
        echo -e "${I_ERR}Invalid value for '--target': '$2' (allowed: clipboard, ansible)"
        exit 1
      } ;;
      esac
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    --*)
      echo -e "${I_ERR}Unknown option: $1"
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done

  # Encrypt options require the 'encrypt' command
  if [[ -z "$SUBCMD" && (-n "$ACTION" || -n "$ARG_TARGET" || ${#positional[@]} -gt 0) ]]; then
    echo -e "${I_ERR}Options '--string', '--file' & '--target' require the 'encrypt' command."
    exit 1
  fi

  # Positional arguments: only '--file [path] [varname]' takes any
  case "$ACTION" in
  file)
    [[ ${#positional[@]} -le 2 ]] || {
      echo -e "${I_ERR}Too many arguments for '--file' (usage: --file [path] [varname])."
      exit 1
    }
    ARG_FILE="${positional[0]:-}"
    ARG_VARNAME="${positional[1]:-}"
    ;;
  *)
    [[ ${#positional[@]} -eq 0 ]] || {
      echo -e "${I_ERR}Unexpected argument: ${positional[0]}"
      exit 1
    }
    ;;
  esac
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  encrypt                         Encrypt a secret as an Ansible-Vault variable
  help, --help, -h                Display this help message
  (none)                          Choose a command interactively

Encrypt Options:
  --string                        Encrypt a string (prompted, input hidden)
  --file [path] [varname]         Encrypt a file's content (prompts for missing values)
  --target <clipboard|ansible>    Copy to clipboard or append to group_vars/all/encrypted.yml
                                  (prompted if omitted)

Global Options:
  --dev-dir <path>                Use a local project directory instead of the installed one
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to encrypt
function setup() {
  install_deps "ansible" "gum"
  use_dev_dir "$ARG_DEV_DIR"

  # Vars file for target 'ansible' (depends on the final X_TARGET_DIR)
  VARFILE="${X_TARGET_DIR}/group_vars/all/encrypted.yml"
}

# --                 -- #
# --     PROMPTS     -- #
# --                 -- #

# Ask for the subcommand (prints "encrypt", "help" or nothing if cancelled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Encrypt" "Help")" in
  "Encrypt") echo "encrypt" ;;
  "Help") echo "help" ;;
  esac
}

# Ask what to encrypt (prints "string", "file" or nothing if cancelled)
function prompt_action() {
  case "$(choose "Choose:" "Encrypt String" "Encrypt File Content")" in
  "Encrypt String") echo "string" ;;
  "Encrypt File Content") echo "file" ;;
  esac
}

# Ask for the output target (prints "clipboard", "ansible" or nothing if cancelled)
function prompt_output_target() {
  case "$(choose "Choose Output Target:" "Copy to Clipboard" "Save to ${VARFILE}")" in
  "Copy to Clipboard") echo "clipboard" ;;
  "Save to ${VARFILE}") echo "ansible" ;;
  esac
}

# --                 -- #
# --     ENCRYPT     -- #
# --                 -- #

# Validate an Ansible variable name: validate_varname <varname>
function validate_varname() {
  [[ -n "$1" ]] || {
    echo -e "${I_ERR}Variable name cannot be empty."
    exit 1
  }
  if [[ ! "$1" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo -e "${I_ERR}Invalid characters in variable name: '$1' (allowed: letters, numbers, underscores)"
    exit 1
  fi
}

# Set ARG_TARGET (prompt if needed) & check for duplicates BEFORE encrypting: resolve_output_target <varname>
function resolve_output_target() {
  local varname="$1"

  if [[ -z "$ARG_TARGET" ]]; then
    if [[ -t 0 ]]; then
      ARG_TARGET="$(prompt_output_target)"
    else
      ARG_TARGET="clipboard"
    fi
  fi

  if [[ -z "$ARG_TARGET" ]]; then
    echo -e "${I_WARN}No target selected. Aborting."
    exit 0
  fi

  if [[ "$ARG_TARGET" == "ansible" ]] && grep -qE "^${varname}:" "$VARFILE" 2>/dev/null; then
    echo -e "${I_ERR}Variable [ ${C_PURPLE}${varname}${C_RESET} ] already exists in [ ${C_PURPLE}${VARFILE}${C_RESET} ]. Please choose a different name."
    exit 1
  fi
}

# Encrypt stdin as an Ansible variable: vault_encrypt <varname> < plaintext
# (reading the plaintext from stdin keeps secrets out of the process list)
function vault_encrypt() {
  ansible-vault encrypt_string \
    --vault-id "onesetup@prompt" \
    --encrypt-vault-id "onesetup" \
    --stdin-name "$1"
}

# Write the encrypted variable to ARG_TARGET: write_output <encrypted> <varname>
function write_output() {
  local encrypted="$1" varname="$2"

  case "$ARG_TARGET" in
  clipboard)
    printf '%s\n' "$encrypted" | copy_to_clipboard
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_PURPLE}${varname}${C_RESET} ] copied to clipboard"
    ;;
  ansible)
    mkdir -p "$(dirname "$VARFILE")"
    # Ensure the file ends with a newline, so the new variable starts on its own line
    if [[ -s "$VARFILE" && -n "$(tail -c 1 "$VARFILE")" ]]; then
      echo >>"$VARFILE"
    fi
    printf '%s\n' "$encrypted" >>"$VARFILE"
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_PURPLE}${varname}${C_RESET} ] appended to [ ${C_PURPLE}${VARFILE}${C_RESET} ]"
    ;;
  esac
}

# Action 'string': encrypt a prompted secret
function encrypt_string() {
  local secret="" varname="" encrypted

  # 'read' returns 1 on EOF – '|| true' lets the empty-check below report it instead of 'set -e'
  printf '%b' "${I_ASK}Secret to Encrypt (hidden): "
  read -rs secret || true
  echo
  [[ -n "$secret" ]] || {
    echo -e "${I_ERR}Secret cannot be empty."
    exit 1
  }

  printf '%b' "${I_ASK}Variable Name: "
  read -r varname || true
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(printf '%s' "$secret" | vault_encrypt "$varname")" || {
    echo -e "${I_ERR}Encryption failed."
    exit 1
  }
  write_output "$encrypted" "$varname"
}

# Action 'file': encrypt a file's content (exact content, incl. trailing newlines)
function encrypt_file() {
  local filepath="$ARG_FILE" varname="$ARG_VARNAME" default_name encrypted

  # Pick a file if no path was given
  if [[ -z "$filepath" ]]; then
    filepath="$(
      gum file "$HOME" \
        --cursor.foreground "$GUM_COLOR" \
        --header.foreground "$GUM_COLOR" \
        --selected.foreground "$GUM_COLOR" \
        --all \
        --height=100 || true
    )"
    if [[ -z "$filepath" ]]; then
      echo -e "${I_WARN}No file selected. Aborting."
      exit 0
    fi
  fi
  [[ -f "$filepath" && -r "$filepath" ]] || {
    echo -e "${I_ERR}File not found or not readable: ${filepath}"
    exit 1
  }

  # Variable name: argument > prompt (prefilled from the file name) > file name
  if [[ -z "$varname" ]]; then
    default_name="$(basename "$filepath")"
    default_name="${default_name//[^a-zA-Z0-9_]/_}"
    if [[ -t 0 ]]; then
      varname="$(
        gum input \
          --cursor.foreground "$GUM_COLOR" \
          --header.foreground "$GUM_COLOR" \
          --prompt.foreground "$GUM_COLOR" \
          --value "$default_name" \
          --header "Adjust variable name (or press Enter to keep default):" \
          --placeholder "$default_name" \
          --width 50 || true
      )"
    fi
    varname="${varname:-$default_name}"
  fi
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(vault_encrypt "$varname" <"$filepath")" || {
    echo -e "${I_ERR}Encryption failed."
    exit 1
  }
  write_output "$encrypted" "$varname"
}

# Call Main Function with args
main "$@"
