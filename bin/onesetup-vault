#!/usr/bin/env bash

# --                               -- #
# --     ONESETUP-VAULT BINARY     -- #
# --                               -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup-vault'

# -- GLOBALS -- #
SUBCMD=""              # encrypt | help | "" (empty → interactive prompt)
ACTION=""              # string | file | "" (empty → interactive prompt)
ARG_TARGET=""          # --target <clipboard|config> ("" → prompt, or clipboard without a terminal)
ARG_FILE=""            # --file [path]
ARG_VARNAME=""         # --file [path] [name]
ARG_VAULT_PASS_FILE="" # --vault-pass-file <path>
ARG_VAULT_PASS=""      # --vault-pass <password> (visible in shell history & process list!)

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [3] Setup (dependencies, target dir)
  setup

  # [4] Ask for missing choices
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    case "$SUBCMD" in
    help)
      print_help
      exit 0
      ;;
    "")
      log_warn "Operation cancelled."
      exit 0
      ;;
    esac
  fi
  if [[ -z "$ACTION" ]]; then
    ACTION="$(prompt_action)"
    if [[ -z "$ACTION" ]]; then
      log_warn "Operation cancelled."
      exit 0
    fi
  fi

  # [5] Run
  case "$ACTION" in
  string) encrypt_string ;;
  file) encrypt_file ;;
  esac
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    exit 1
  }
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD, ACTION & ARG_*, no side effects)
function parse_args() {
  local positional=()

  # Optional subcommand as first argument
  case "${1:-}" in
  encrypt)
    SUBCMD="encrypt"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (global & vault options still allowed)
  *)
    print_help >&2
    log_err "Unknown command: $1"
    exit 1
    ;;
  esac

  # Options & positional arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --string | --file)
      if [[ -n "$ACTION" ]]; then
        log_err "Cannot specify both '--string' and '--file'."
        exit 1
      fi
      ACTION="${1#--}"
      shift
      ;;
    --target)
      require_value "$1" "${2:-}"
      case "$2" in
      clipboard | config) ARG_TARGET="$2" ;;
      *) {
        log_err "Invalid value for '--target': '$2' (allowed: clipboard, config)"
        exit 1
      } ;;
      esac
      shift 2
      ;;
    --vault-pass-file)
      require_value "$1" "${2:-}"
      ARG_VAULT_PASS_FILE="$2"
      shift 2
      ;;
    --vault-pass)
      require_value "$1" "${2:-}"
      ARG_VAULT_PASS="$2"
      shift 2
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    --*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done

  # Encrypt options require the 'encrypt' command
  if [[ -z "$SUBCMD" && (-n "$ACTION" || -n "$ARG_TARGET" || ${#positional[@]} -gt 0) ]]; then
    log_err "Options '--string', '--file' & '--target' require the 'encrypt' command."
    exit 1
  fi

  # Vault password: only one source, and the file must be readable
  if [[ -n "$ARG_VAULT_PASS" && -n "$ARG_VAULT_PASS_FILE" ]]; then
    log_err "Cannot specify both '--vault-pass' and '--vault-pass-file'."
    exit 1
  fi
  if [[ -n "$ARG_VAULT_PASS_FILE" ]] && [[ -d "$ARG_VAULT_PASS_FILE" || ! -r "$ARG_VAULT_PASS_FILE" ]]; then
    log_err "Vault password file not found or not readable: ${ARG_VAULT_PASS_FILE}"
    exit 1
  fi

  # Positional arguments: only '--file [path] [name]' takes any
  case "$ACTION" in
  file)
    [[ ${#positional[@]} -le 2 ]] || {
      log_err "Too many arguments for '--file' (usage: --file [path] [name])."
      exit 1
    }
    ARG_FILE="${positional[0]:-}"
    ARG_VARNAME="${positional[1]:-}"
    ;;
  *)
    [[ ${#positional[@]} -eq 0 ]] || {
      log_err "Unexpected argument: ${positional[0]}"
      exit 1
    }
    ;;
  esac
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  encrypt                         Encrypt a secret as an Ansible-Vault variable
  help, --help, -h                Display this help message
  (none)                          Choose a command interactively

Encrypt Options:
  --string                        Encrypt a string (prompted, input hidden)
  --file [path] [name]            Encrypt a file's content (prompts for missing values)
  --target <clipboard|config>     Copy to clipboard, or write it into the config file
                                  (prompted if omitted)

  The name is the key in the config file, e.g. 'ssh.identities.id_ed25519'.
  Config file: ${ONESETUP_CONFIG}

Vault Password Options (default: ONESETUP_VAULT_PASS, else prompted by ansible-vault):
  --vault-pass-file <path>        Read the vault password from a file
                                  (executable files are run as a script by ansible-vault)
  --vault-pass <password>         Use this vault password
                                  (visible in shell history & process list – prefer --vault-pass-file)
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to encrypt
function setup() {
  install_deps "ansible" "gum" "yq"
  # The python 'yq' wrapper cannot write the '!vault' tag
  yq --version 2>/dev/null | grep -q "mikefarah" || {
    log_err "onesetup-vault needs mikefarah/yq (https://github.com/mikefarah/yq), found another 'yq' in PATH."
    exit 1
  }

  # No vault password option given → ONESETUP_VAULT_PASS (env or config 'secrets:', may be a password manager reference)
  if [[ -z "$ARG_VAULT_PASS" && -z "$ARG_VAULT_PASS_FILE" ]]; then
    load_secrets ONESETUP_VAULT_PASS
    ARG_VAULT_PASS="$ONESETUP_VAULT_PASS"
  fi
}

# --                 -- #
# --     PROMPTS     -- #
# --                 -- #

# Ask for the subcommand (prints "encrypt", "help" or nothing if cancelled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Encrypt" "Help")" in
  "Encrypt") echo "encrypt" ;;
  "Help") echo "help" ;;
  esac
}

# Ask what to encrypt (prints "string", "file" or nothing if cancelled)
function prompt_action() {
  case "$(choose "Choose:" "Encrypt String" "Encrypt File Content")" in
  "Encrypt String") echo "string" ;;
  "Encrypt File Content") echo "file" ;;
  esac
}

# Ask for the output target (prints "clipboard", "config" or nothing if cancelled)
function prompt_output_target() {
  case "$(choose "Choose Output Target:" "Copy to Clipboard" "Save to ${ONESETUP_CONFIG}")" in
  "Copy to Clipboard") echo "clipboard" ;;
  "Save to ${ONESETUP_CONFIG}") echo "config" ;;
  esac
}

# --                 -- #
# --     ENCRYPT     -- #
# --                 -- #

# Validate a name / config key path: validate_varname <name>
function validate_varname() {
  [[ -n "$1" ]] || {
    log_err "Name cannot be empty."
    exit 1
  }
  if [[ ! "$1" =~ ^[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)*$ ]]; then
    log_err "Invalid name: '$1' (allowed: letters, numbers & underscores, nested keys separated by dots)"
    exit 1
  fi
}

# Set ARG_TARGET (prompt if needed) & check for duplicates BEFORE encrypting: resolve_output_target <varname>
function resolve_output_target() {
  local varname="$1"

  if [[ -z "$ARG_TARGET" ]]; then
    if [[ -t 0 ]]; then
      ARG_TARGET="$(prompt_output_target)"
    else
      ARG_TARGET="clipboard"
    fi
  fi

  if [[ -z "$ARG_TARGET" ]]; then
    log_warn "No target selected. Aborting."
    exit 0
  fi

  if [[ "$ARG_TARGET" == "config" ]]; then
    [[ -f "$ONESETUP_CONFIG" ]] || {
      log_err "Config file not found: ${ONESETUP_CONFIG} (run 'onesetup-init' first)"
      exit 1
    }
    # 'yq -e' exits non-zero when the key is missing or null
    if yq -e ".${varname}" "$ONESETUP_CONFIG" &>/dev/null; then
      log_err "Key [ ${C_PURPLE}${varname}${C_RESET} ] already exists in [ ${C_PURPLE}${ONESETUP_CONFIG}${C_RESET} ]. Please choose a different name."
      exit 1
    fi
  fi
}

# Encrypt stdin: vault_encrypt <name> < plaintext
# Target 'clipboard' → "<last key>: !vault |..." | target 'config' → only the vault ciphertext
# (reading the plaintext from stdin keeps secrets out of the process list)
# Vault password source: --vault-pass > --vault-pass-file > interactive prompt
function vault_encrypt() {
  local args=(encrypt_string --encrypt-vault-id "onesetup")
  if [[ "$ARG_TARGET" == "clipboard" ]]; then
    args+=(--stdin-name "${1##*.}")
  fi

  if [[ -n "$ARG_VAULT_PASS" ]]; then
