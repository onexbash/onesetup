#!/usr/bin/env bash

# --                               -- #
# --     ONESETUP-VAULT BINARY     -- #
# --                               -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup-vault'

# -- GLOBALS -- #
SUBCMD=""              # encrypt | help | "" (empty → interactive prompt)
ACTION=""              # string | file | "" (empty → interactive prompt)
ARG_TARGET=""          # --target <clipboard|config> ("" → prompt, or clipboard without a terminal)
ARG_FILE=""            # --file [path]
ARG_VARNAME=""         # --file [path] [name]
ARG_VAULT_PASS_FILE="" # --vault-pass-file <path>
ARG_VAULT_PASS=""      # --vault-pass <password> (visible in shell history & process list!)

# -- MAIN -- #
function main() {
  # [1] Load utilities (onesetup-util applies styles, shell modes & config on load)
  load_utils

  # [2] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [3] Setup (dependencies, target dir)
  setup

  # [4] Ask for missing choices
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    case "$SUBCMD" in
    help)
      print_help
      exit 0
      ;;
    "")
      echo -e "${I_WARN}Operation cancelled."
      exit 0
      ;;
    esac
  fi
  if [[ -z "$ACTION" ]]; then
    ACTION="$(prompt_action)"
    if [[ -z "$ACTION" ]]; then
      echo -e "${I_WARN}Operation cancelled."
      exit 0
    fi
  fi

  # [5] Run
  case "$ACTION" in
  string) encrypt_string ;;
  file) encrypt_file ;;
  esac
}

# Source onesetup-util from the directory this executable lives in
function load_utils() {
  local this_dir
  this_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=/dev/null
  source "${this_dir}/onesetup-util" || {
    echo -e "[ERROR] Failed to load 'onesetup-util' from: ${this_dir}" >&2
    exit 1
  }
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD, ACTION & ARG_*, no side effects)
function parse_args() {
  local positional=()

  # Optional subcommand as first argument
  case "${1:-}" in
  encrypt)
    SUBCMD="encrypt"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (global & vault options still allowed)
  *)
    print_help >&2
    echo -e "${I_ERR}Unknown command: $1"
    exit 1
    ;;
  esac

  # Options & positional arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --string | --file)
      if [[ -n "$ACTION" ]]; then
        echo -e "${I_ERR}Cannot specify both '--string' and '--file'."
        exit 1
      fi
      ACTION="${1#--}"
      shift
      ;;
    --target)
      require_value "$1" "${2:-}"
      case "$2" in
      clipboard | config) ARG_TARGET="$2" ;;
      *) {
        echo -e "${I_ERR}Invalid value for '--target': '$2' (allowed: clipboard, config)"
        exit 1
      } ;;
      esac
      shift 2
      ;;
    --vault-pass-file)
      require_value "$1" "${2:-}"
      ARG_VAULT_PASS_FILE="$2"
      shift 2
      ;;
    --vault-pass)
      require_value "$1" "${2:-}"
      ARG_VAULT_PASS="$2"
      shift 2
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    --*)
      echo -e "${I_ERR}Unknown option: $1"
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done

  # Encrypt options require the 'encrypt' command
  if [[ -z "$SUBCMD" && (-n "$ACTION" || -n "$ARG_TARGET" || ${#positional[@]} -gt 0) ]]; then
    echo -e "${I_ERR}Options '--string', '--file' & '--target' require the 'encrypt' command."
    exit 1
  fi

  # Vault password: only one source, and the file must be readable
  if [[ -n "$ARG_VAULT_PASS" && -n "$ARG_VAULT_PASS_FILE" ]]; then
    echo -e "${I_ERR}Cannot specify both '--vault-pass' and '--vault-pass-file'."
    exit 1
  fi
  if [[ -n "$ARG_VAULT_PASS_FILE" ]] && [[ -d "$ARG_VAULT_PASS_FILE" || ! -r "$ARG_VAULT_PASS_FILE" ]]; then
    echo -e "${I_ERR}Vault password file not found or not readable: ${ARG_VAULT_PASS_FILE}"
    exit 1
  fi

  # Positional arguments: only '--file [path] [name]' takes any
  case "$ACTION" in
  file)
    [[ ${#positional[@]} -le 2 ]] || {
      echo -e "${I_ERR}Too many arguments for '--file' (usage: --file [path] [name])."
      exit 1
    }
    ARG_FILE="${positional[0]:-}"
    ARG_VARNAME="${positional[1]:-}"
    ;;
  *)
    [[ ${#positional[@]} -eq 0 ]] || {
      echo -e "${I_ERR}Unexpected argument: ${positional[0]}"
      exit 1
    }
    ;;
  esac
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  encrypt                         Encrypt a secret as an Ansible-Vault variable
  help, --help, -h                Display this help message
  (none)                          Choose a command interactively

Encrypt Options:
  --string                        Encrypt a string (prompted, input hidden)
  --file [path] [name]            Encrypt a file's content (prompts for missing values)
  --target <clipboard|config>     Copy to clipboard, or write it into the config file
                                  (prompted if omitted)

  The name is the key in the config file, e.g. 'ssh.identities.id_ed25519'.
  Config file: ${ONESETUP_CONFIG}

Vault Password Options (default: prompted by ansible-vault):
  --vault-pass-file <path>        Read the vault password from a file
                                  (executable files are run as a script by ansible-vault)
  --vault-pass <password>         Use this vault password
                                  (visible in shell history & process list – prefer --vault-pass-file)
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to encrypt
function setup() {
  install_deps "ansible" "gum" "yq"
  # The python 'yq' wrapper cannot write the '!vault' tag
  yq --version 2>/dev/null | grep -q "mikefarah" || {
    echo -e "${I_ERR}onesetup-vault needs mikefarah/yq (https://github.com/mikefarah/yq), found another 'yq' in PATH."
    exit 1
  }
}

# --                 -- #
# --     PROMPTS     -- #
# --                 -- #

# Ask for the subcommand (prints "encrypt", "help" or nothing if cancelled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Encrypt" "Help")" in
  "Encrypt") echo "encrypt" ;;
  "Help") echo "help" ;;
  esac
}

# Ask what to encrypt (prints "string", "file" or nothing if cancelled)
function prompt_action() {
  case "$(choose "Choose:" "Encrypt String" "Encrypt File Content")" in
  "Encrypt String") echo "string" ;;
  "Encrypt File Content") echo "file" ;;
  esac
}

# Ask for the output target (prints "clipboard", "config" or nothing if cancelled)
function prompt_output_target() {
  case "$(choose "Choose Output Target:" "Copy to Clipboard" "Save to ${ONESETUP_CONFIG}")" in
  "Copy to Clipboard") echo "clipboard" ;;
  "Save to ${ONESETUP_CONFIG}") echo "config" ;;
  esac
}

# --                 -- #
# --     ENCRYPT     -- #
# --                 -- #

# Validate a name / config key path: validate_varname <name>
function validate_varname() {
  [[ -n "$1" ]] || {
    echo -e "${I_ERR}Name cannot be empty."
    exit 1
  }
  if [[ ! "$1" =~ ^[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)*$ ]]; then
    echo -e "${I_ERR}Invalid name: '$1' (allowed: letters, numbers & underscores, nested keys separated by dots)"
    exit 1
  fi
}

# Set ARG_TARGET (prompt if needed) & check for duplicates BEFORE encrypting: resolve_output_target <varname>
function resolve_output_target() {
  local varname="$1"

  if [[ -z "$ARG_TARGET" ]]; then
    if [[ -t 0 ]]; then
      ARG_TARGET="$(prompt_output_target)"
    else
      ARG_TARGET="clipboard"
    fi
  fi

  if [[ -z "$ARG_TARGET" ]]; then
    echo -e "${I_WARN}No target selected. Aborting."
    exit 0
  fi

  if [[ "$ARG_TARGET" == "config" ]]; then
    [[ -f "$ONESETUP_CONFIG" ]] || {
      echo -e "${I_ERR}Config file not found: ${ONESETUP_CONFIG} (run 'onesetup-init' first)"
      exit 1
    }
    # 'yq -e' exits non-zero when the key is missing or null
    if yq -e ".${varname}" "$ONESETUP_CONFIG" &>/dev/null; then
      echo -e "${I_ERR}Key [ ${C_PURPLE}${varname}${C_RESET} ] already exists in [ ${C_PURPLE}${ONESETUP_CONFIG}${C_RESET} ]. Please choose a different name."
      exit 1
    fi
  fi
}

# Encrypt stdin: vault_encrypt <name> < plaintext
# Target 'clipboard' → "<last key>: !vault |..." | target 'config' → only the vault ciphertext
# (reading the plaintext from stdin keeps secrets out of the process list)
# Vault password source: --vault-pass > --vault-pass-file > interactive prompt
function vault_encrypt() {
  local args=(encrypt_string --encrypt-vault-id "onesetup")
  if [[ "$ARG_TARGET" == "clipboard" ]]; then
    args+=(--stdin-name "${1##*.}")
  fi

  if [[ -n "$ARG_VAULT_PASS" ]]; then
    # Hand the password over through a pipe (/dev/fd/N): no temp file, not in ansible-vault's argv
    ansible-vault "${args[@]}" --vault-id "onesetup@"<(printf '%s\n' "$ARG_VAULT_PASS")
  elif [[ -n "$ARG_VAULT_PASS_FILE" ]]; then
    ansible-vault "${args[@]}" --vault-id "onesetup@${ARG_VAULT_PASS_FILE}"
  else
    ansible-vault "${args[@]}" --vault-id "onesetup@prompt"
  fi
}

# Write the encrypted variable to ARG_TARGET: write_output <encrypted> <varname>
function write_output() {
  local encrypted="$1" varname="$2"

  case "$ARG_TARGET" in
  clipboard)
    printf '%s\n' "$encrypted" | copy_to_clipboard
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_PURPLE}${varname}${C_RESET} ] copied to clipboard"
    ;;
  config)
    # Drop the '!vault |' header & indentation, then write it as a tagged literal block (keeps comments)
    VAULT_VALUE="$(printf '%s\n' "$encrypted" | sed -e '1s/^!vault |$//' -e 's/^ *//' -e '/^$/d')" \
      yq -i ".${varname} = strenv(VAULT_VALUE) | .${varname} tag = \"!vault\" | .${varname} style = \"literal\"" "$ONESETUP_CONFIG" || {
      echo -e "${I_ERR}Failed to write [ ${varname} ] to ${ONESETUP_CONFIG}"
      exit 1
    }
    echo -e "${I_OK}Encrypted value written to [ ${C_PURPLE}${varname}${C_RESET} ] in [ ${C_PURPLE}${ONESETUP_CONFIG}${C_RESET} ]"
    ;;
  esac
}

# Action 'string': encrypt a prompted secret
function encrypt_string() {
  local secret="" varname="" encrypted

  # 'read' returns 1 on EOF – '|| true' lets the empty-check below report it instead of 'set -e'
  printf '%b' "${I_ASK}Secret to Encrypt (hidden): "
  read -rs secret || true
  echo
  [[ -n "$secret" ]] || {
    echo -e "${I_ERR}Secret cannot be empty."
    exit 1
  }

  printf '%b' "${I_ASK}Name (e.g. ssh.config): "
  read -r varname || true
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(printf '%s' "$secret" | vault_encrypt "$varname")" || {
    echo -e "${I_ERR}Encryption failed."
    exit 1
  }
  write_output "$encrypted" "$varname"
}

# Action 'file': encrypt a file's content (exact content, incl. trailing newlines)
function encrypt_file() {
  local filepath="$ARG_FILE" varname="$ARG_VARNAME" default_name encrypted rows

  # Pick a file if no path was given
  if [[ -z "$filepath" ]]; then
    # Fit the picker into the terminal (leave room for header & prompt)
    rows="$(stty size </dev/tty 2>/dev/null | cut -d' ' -f1)"
    rows="${rows:-24}"
    ((rows > 8)) || rows=8
    filepath="$(
      find . -maxdepth 3 -type f -not -path '*/.git/*' 2>/dev/null |
        sed 's|^\./||' | sort |
        gum filter \
          --header "Choose file to encrypt:" \
          --header.foreground "$GUM_COLOR" \
          --indicator.foreground "$GUM_COLOR" \
          --match.foreground "$GUM_COLOR" \
          --placeholder "Type to search..." \
          --height "$((rows - 4))" || true
    )"
    if [[ -z "$filepath" ]]; then
      echo -e "${I_WARN}No file selected. Aborting."
      exit 0
    fi
  fi

  [[ -f "$filepath" && -r "$filepath" ]] || {
    echo -e "${I_ERR}File not found or not readable: ${filepath}"
    exit 1
  }

  # Variable name: argument > prompt (prefilled from the file name) > file name
  if [[ -z "$varname" ]]; then
    default_name="$(basename "$filepath")"
    default_name="${default_name//[^a-zA-Z0-9_]/_}"
    if [[ -t 0 ]]; then
      varname="$(
        gum input \
          --cursor.foreground "$GUM_COLOR" \
          --header.foreground "$GUM_COLOR" \
          --prompt.foreground "$GUM_COLOR" \
          --value "$default_name" \
          --header "Adjust name, e.g. ssh.identities.${default_name} (or press Enter to keep it):" \
          --placeholder "$default_name" \
          --width 50 || true
      )"
    fi
    varname="${varname:-$default_name}"
  fi
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(vault_encrypt "$varname" <"$filepath")" || {
    echo -e "${I_ERR}Encryption failed."
    exit 1
  }
  write_output "$encrypted" "$varname"
}

# Call Main Function with args
main "$@"
