#!/usr/bin/env bash

# --                               -- #
# --     ONESETUP-VAULT BINARY     -- #
# --                               -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup-vault'

# [0] Main Function
function main() {
  # Function Calls
  load_utils
  { read_config && echo -e "${I_OK}Config File read"; } || { echo -e "${I_ERR}Failed to read Config File"; exit 1; }
  install_deps || { echo -e "${I_ERR}Failed to install dependencies"; exit 1; }
  parse_args "$@" || { echo -e "${I_ERR}Failed to parse Command arguments"; exit 1; }
}

# [1] Source Utility Script
function load_utils(){
  local system_install_dir="$HOME/.local/share/onesetup" # TODO: Implement support for customized installation directory
  source "${system_install_dir}/scripts/util.sh" && echo -e "${I_OK}Utility Script sourced" || { echo -e "${I_ERR}Failed to source Utility Script"; exit 1; }
}

# [2] Dependency Installation
function install_deps() {
  local os pkg_list
  os="$(detect_os)"
  pkg_list=("gum" "ansible")

  for pkg in "${pkg_list[@]}"; do
    if command -v "$pkg" &>/dev/null; then
      continue
    fi

    echo -e "${I_INFO}Dependency missing: ${C_RED}$pkg${C_RESET}. Installing..."

    case "$os" in
    macos)
      if ! command -v "brew" &>/dev/null; then
        echo -e "${I_ERR}Homebrew is not installed on your system. Please install & re-run this script."
        echo -e "${I_INFO}Install Homebrew from: ${C_BLUE}https://brew.sh${C_RESET}"
        exit 1
      fi
      brew install "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg"; exit 1; }
      ;;
    linux)
      install_linux_pkg "$pkg" || { echo -e "${I_ERR}Failed to install: $pkg"; exit 1; }
      ;;
    windows)
      echo -e "${I_ERR}Windows Support Coming soon.." && exit 1
      ;;
    *)
      echo -e "${I_ERR}Unsupported OS." && exit 1
      ;;
    esac
  done
}

# [3] Command Arguments Parser
function parse_args() {
  if [[ $# -eq 0 ]]; then
    prompt_subcommand
    return 0
  fi

  case "${1:-}" in
  encrypt)
    shift
    parse_encrypt_args "$@"
    ;;
  decrypt)
    shift
    parse_decrypt_args "$@"
    ;;
  help | --help | -h)
    print_help
    ;;
  *)
    echo -e "${I_ERR}Unknown command: $1"
    print_help
    exit 1
    ;;
  esac
}

# --                              -- #
# --     SUBCOMMAND FUNCTIONS     -- #
# --                              -- #

# Subcommand: 'help': Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  encrypt                  Encrypt secrets with Ansible-Vault
    --string               Interactively encrypt a plain text string
    --file <path> [var]    Encrypt file contents as an Ansible variable
  decrypt                  Decrypt secrets with Ansible-Vault
    --arg1                 Placeholder for decrypt option 1
    --arg2                 Placeholder for decrypt option 2
  help, -h, --help         Display this help message
EOF
}

# Prompt 'target' argument for Subcommand 'encrypt'
function prompt_encrypt_target() {
  local choice
  choice=$(
    gum choose "Copy to Clipboard" "Save to $ONESETUP_VARFILE_ENCRYPTED" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose Output Target:" \
      --no-show-help \
      --ordered || true
  )
  case "$choice" in
  "Copy to Clipboard") echo "clipboard" ;;
  "Save to $ONESETUP_VARFILE_ENCRYPTED") echo "ansible" ;;
  *) echo "" ;;
  esac
}

# Check if variable name already exists in ONESETUP_VARFILE_ENCRYPTED
function check_duplicates_varfile() {
  local varname="$1"
  if [[ -f "$ONESETUP_VARFILE_ENCRYPTED" ]]; then
    if grep -qE "^${varname}:" "$ONESETUP_VARFILE_ENCRYPTED"; then
      return 0 # Duplicate exists
    fi
  fi
  return 1 # No Duplicates
}

# Resolve target output and validate duplicates BEFORE encrypting
function prepare_output_target() {
  local target="$1"
  local varname="$2"

  # If target wasn't explicitly supplied via CLI, ask or default
  if [[ -z "$target" ]]; then
    if [[ -t 0 ]]; then
      target=$(prompt_encrypt_target)
    else
      target="clipboard"
    fi
  fi

  # If target is ansible, check for variable duplicates in group_vars/all/encrypted.yml
  # TODO: implement target 'ssh' that uses group_vars/all/ssh.yml
  # TODO: make it work when the command is run outside of the onesetup project directory
  if [[ "$target" == "ansible" ]]; then
    if check_duplicates_varfile "$varname"; then
      echo -e "${I_ERR}Variable [ ${C_MAGENTA}$varname${C_RESET} ] already exists in [ ${C_MAGENTA}$ONESETUP_VARFILE_ENCRYPTED${C_RESET} ]."
      echo -e "${I_INFO}Please choose a different variable name to prevent overwriting."
      return 1
    fi
  fi

  # Echo resolved target back to caller
  echo "$target"
}

# Handle output based on validated target
function handle_encrypted_output() {
  local encrypted_res="$1"
  local varname="$2"
  local target="$3"

  case "$target" in
  clipboard)
    echo "$encrypted_res" | copy_to_clipboard
    echo -e "${I_OK}Encrypted string copied to clipboard with Ansible Variable [ ${C_MAGENTA}$varname${C_RESET} ]"
    ;;
  ansible)
    # Create destination directory if missing
    mkdir -p "$(dirname "$ONESETUP_VARFILE_ENCRYPTED")"

    # Append to target file
    echo "$encrypted_res" >> "$ONESETUP_VARFILE_ENCRYPTED"
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_MAGENTA}$varname${C_RESET} ] appended to [ ${C_MAGENTA}$ONESETUP_VARFILE_ENCRYPTED${C_RESET} ]"
    ;;
  *)
    echo -e "${I_WARN}No target selected. Aborting."
    return 1
    ;;
  esac
}

# Subcommand 'encrypt': --string
function encrypt_string() {
  local target="$1"
  local secret=""
  local varname=""

  # Prompt for Secret to be encrypted
  printf "%b" "${I_ASK}Secret to Encrypt: "
  read -r secret
  if [[ -z "$secret" ]]; then
    echo -e "${I_ERR}Secret cannot be empty."
    return 1
  fi

  # Prompt for Variable Name
  printf "%b" "${I_ASK}Variable Name: "
  read -r varname
  if [[ -z "$varname" ]]; then
    echo -e "${I_ERR}Variable name cannot be empty."
    return 1
  fi

  # Validate $varname for invalid characters
  if [[ ! "$varname" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo -e "${I_ERR}Invalid Characters in Variable Name"
    echo -e "${I_INFO}Allowed Characters: Letters[a-z|A-Z], Numbers[0-9], Underscores[_]"
    return 1
  fi

  # Resolve target & run duplicate check BEFORE encrypting
  target=$(prepare_output_target "$target" "$varname") || return 1

  # Encrypt with Ansible-Vault
  local encrypted_res
  encrypted_res=$(ansible-vault encrypt_string \
    --show-input \
    --vault-id "onesetup@prompt" \
    --encrypt-vault-id "onesetup" \
    --name "$varname" \
    "$secret")

  # Pass encrypted Result to Handler function
  handle_encrypted_output "$encrypted_res" "$varname" "$target"
}

# Subcommand 'encrypt': --file
function encrypt_file() {
  local target="$1"
  shift
  local filepath="${1:-}"
  local varname="${2:-}"

  # Prompt interactively if filepath is not provided
  if [[ -z "$filepath" ]]; then
    filepath=$(
      gum file "$HOME" \
        --cursor.foreground "#cba6f7" \
        --header.foreground "#cba6f7" \
        --selected.foreground "#cba6f7" \
        --all \
        --height=100 || true
    )
    if [[ -z "$filepath" ]]; then
      echo -e "${I_WARN}No file selected. Aborting."
      return 1
    fi
  fi

  # Check if file exists
  if [[ ! -f "$filepath" ]]; then
    echo -e "${I_ERR}File not found: $filepath"
    return 1
  fi

  # Format variable name fallback from filename
  local filename
  filename=$(basename "$filepath")
  local filename_fmt="${filename//./_}"

  # Prompt interactively for variable name if missing and running in terminal
  if [[ -z "$varname" ]]; then
    if [[ -t 0 ]]; then
      varname=$(
        gum input \
          --cursor.foreground "#cba6f7" \
          --header.foreground "#cba6f7" \
          --prompt.foreground "#cba6f7" \
          --value "$filename_fmt" \
          --header "Adjust variable name (or press Enter to keep default):" \
          --placeholder "$filename_fmt" \
          --width 50 || true
      )
    fi
    varname="${varname:-$filename_fmt}"
  fi

  # Validate $varname for invalid characters
  if [[ ! "$varname" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo -e "${I_ERR}Invalid Characters in Variable Name"
    echo -e "${I_INFO}Allowed Characters: Letters[a-z|A-Z], Numbers[0-9], Underscores[_]"
    return 1
  fi

  # Resolve target & run duplicate check BEFORE encrypting
  target=$(prepare_output_target "$target" "$varname") || return 1

  # Read the file content
  local filecontent
  filecontent=$(<"$filepath")

  # Encrypt with Ansible-Vault
  local encrypted_res
  encrypted_res=$(ansible-vault encrypt_string \
    --show-input \
    --vault-id "onesetup@prompt" \
    --encrypt-vault-id "onesetup" \
    --name "$varname" \
    "$filecontent")

  # Pass encrypted Result to Handler function
  handle_encrypted_output "$encrypted_res" "$varname" "$target"
}

# Subcommand 'decrypt': --arg1
function decrypt_arg1() {
  echo -e "${I_INFO}: Coming soon.."
}

# Subcommand 'decrypt': --arg2
function decrypt_arg2() {
  echo -e "${I_INFO}: Coming soon.."
}

# Prompt args for Subcommand 'encrypt'
function prompt_encrypt() {
  local choice
  choice=$(
    gum choose "Encrypt String" "Encrypt File Content" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )

  case "$choice" in
  "Encrypt String") encrypt_string "" ;;
  "Encrypt File Content") encrypt_file "" ;;
  *) echo -e "${I_WARN}Operation cancelled." ;;
  esac
}

# Prompt args for Subcommand 'decrypt'
function prompt_decrypt() {
  local choice
  choice=$(
    gum choose "arg1" "arg2" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )

  case "$choice" in
  "arg1") decrypt_arg1 ;;
  "arg2") decrypt_arg2 ;;
  *) echo -e "${I_WARN}Operation cancelled." ;;
  esac
}

# Prompt for Subcommand to run
function prompt_subcommand() {
  local choice
  choice=$(
    gum choose "Encrypt" "Decrypt" \
      --cursor.foreground "#cba6f7" \
      --header.foreground "#cba6f7" \
      --selected.foreground "#cba6f7" \
      --header "Choose:" \
      --no-show-help \
      --ordered || true
  )

  case "$choice" in
  "Encrypt") prompt_encrypt ;;
  "Decrypt") prompt_decrypt ;;
  *) echo -e "${I_WARN}Operation cancelled." ;;
  esac
}

# Parse Subcommand 'encrypt'
function parse_encrypt_args() {
  if [[ $# -eq 0 ]]; then
    prompt_encrypt
    return 0
  fi

  local action=""
  local target=""
  local action_args=()

  # Validate arguments
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
    --string | --file)
      if [[ -n "$action" ]]; then
        echo -e "${I_ERR}Cannot specify both '--string' and '--file'."
        exit 1
      fi
      action="$1"
      shift
      ;;
    --target)
      if [[ $# -lt 2 ]]; then
        echo -e "${I_ERR}Flag '--target' requires a value (clipboard | ansible)."
        exit 1
      fi
      target="$2"
      shift 2

      # Validate target value immediately
      if [[ "$target" != "clipboard" && "$target" != "ansible" ]]; then
        echo -e "${I_ERR}Invalid value for '--target': '$target'"
        echo -e "${I_INFO}Allowed values: ${C_MAGENTA}clipboard${C_RESET}, ${C_MAGENTA}ansible${C_RESET}"
        exit 1
      fi
      ;;
    *)
      action_args+=("$1")
      shift
      ;;
    esac
  done

  case "$action" in
  --string)
    encrypt_string "$target" "${action_args[@]}"
    ;;
  --file)
    encrypt_file "$target" "${action_args[@]}"
    ;;
  *)
    echo -e "${I_ERR}Missing encrypt option."
    echo -e "${I_INFO}Usage: $(basename "$0") encrypt [--string | --file <path> [varname]] [--target clipboard|ansible]"
    exit 1
    ;;
  esac
}

# Parse Subcommand 'decrypt'
function parse_decrypt_args() {
  if [[ $# -eq 0 ]]; then
    prompt_decrypt
    return 0
  fi

  case "${1:-}" in
  --arg1)
    shift
    decrypt_arg1 "$@"
    ;;
  --arg2)
    shift
    decrypt_arg2 "$@"
    ;;
  *)
    echo -e "${I_ERR}Unknown argument for 'decrypt': $1"
    echo -e "${I_INFO}Usage: $(basename "$0") decrypt [--arg1 | --arg2]"
    exit 1
    ;;
  esac
}

# Call Main Function with args
main "$@"
