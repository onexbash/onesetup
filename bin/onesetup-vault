#!/usr/bin/env bash

# --                               -- #
# --     ONESETUP-VAULT BINARY     -- #
# --                               -- #
# Rolled out by 'install.sh' | Registers Command 'onesetup-vault'

# -- GLOBALS -- #
SUBCMD=""      # encrypt | help | "" (empty → interactive prompt)
ACTION=""      # string | file | "" (empty → interactive prompt)
ARG_TARGET=""  # --target <clipboard|ansible> ("" → prompt, or clipboard without a terminal)
ARG_FILE=""    # --file [path]
ARG_VARNAME="" # --file [path] [varname]
ARG_DEV_DIR="" # --dev-dir <path>
TARGET_DIR=""  # Project directory (set by resolve_target_dir)
VARFILE=""     # Vars file for target 'ansible' (set in setup)
GUM_COLOR="#cba6f7"

# -- HELPERS -- #
# Print an error & exit
function die() {
  echo -e "${I_ERR:-[ERROR] }$*" >&2
  exit 1
}

# Print a warning
function warn() {
  echo -e "${I_WARN:-[WARN] }$*" >&2
}

# Ensure a flag has a value: require_value <flag> <value>
function require_value() {
  if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
    die "Flag '$1' requires a value."
  fi
}

# Styled single choice: choose <header> <option>... (prints the choice, or nothing if cancelled)
function choose() {
  local header="$1"
  shift
  gum choose "$@" \
    --cursor.foreground "$GUM_COLOR" \
    --header.foreground "$GUM_COLOR" \
    --selected.foreground "$GUM_COLOR" \
    --header "$header" \
    --no-show-help \
    --ordered || true
}

# -- MAIN -- #
function main() {
  # [1] Parse & validate all arguments
  parse_args "$@"
  if [[ "$SUBCMD" == "help" ]]; then
    print_help
    exit 0
  fi

  # [2] Setup (utils, config, dependencies)
  setup

  # [3] Ask for missing choices
  if [[ -z "$SUBCMD" ]]; then
    SUBCMD="$(prompt_subcommand)"
    case "$SUBCMD" in
    help)
      print_help
      exit 0
      ;;
    "")
      warn "Operation cancelled."
      exit 0
      ;;
    esac
  fi
  if [[ -z "$ACTION" ]]; then
    ACTION="$(prompt_action)"
    if [[ -z "$ACTION" ]]; then
      warn "Operation cancelled."
      exit 0
    fi
  fi

  # [4] Run
  case "$ACTION" in
  string) encrypt_string ;;
  file) encrypt_file ;;
  esac
}

# --                     -- #
# --     ARG PARSING     -- #
# --                     -- #

# Parse Command Arguments & Subcommand (sets SUBCMD, ACTION & ARG_*, no side effects)
function parse_args() {
  local positional=()

  # Optional subcommand as first argument
  case "${1:-}" in
  encrypt)
    SUBCMD="encrypt"
    shift
    ;;
  help | --help | -h)
    SUBCMD="help"
    return 0
    ;;
  "" | --*) ;; # no subcommand → interactive prompt (--dev-dir still allowed)
  *)
    print_help >&2
    die "Unknown command: $1"
    ;;
  esac

  # Options & positional arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --string | --file)
      if [[ -n "$ACTION" ]]; then
        die "Cannot specify both '--string' and '--file'."
      fi
      ACTION="${1#--}"
      shift
      ;;
    --target)
      require_value "$1" "${2:-}"
      case "$2" in
      clipboard | ansible) ARG_TARGET="$2" ;;
      *) die "Invalid value for '--target': '$2' (allowed: clipboard, ansible)" ;;
      esac
      shift 2
      ;;
    --dev-dir)
      require_value "$1" "${2:-}"
      ARG_DEV_DIR="$2"
      shift 2
      ;;
    -h | --help)
      SUBCMD="help"
      return 0
      ;;
    --*)
      die "Unknown option: $1"
      ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done

  # Encrypt options require the 'encrypt' command
  if [[ -z "$SUBCMD" && (-n "$ACTION" || -n "$ARG_TARGET" || ${#positional[@]} -gt 0) ]]; then
    die "Options '--string', '--file' & '--target' require the 'encrypt' command."
  fi

  # Positional arguments: only '--file [path] [varname]' takes any
  case "$ACTION" in
  file)
    [[ ${#positional[@]} -le 2 ]] || die "Too many arguments for '--file' (usage: --file [path] [varname])."
    ARG_FILE="${positional[0]:-}"
    ARG_VARNAME="${positional[1]:-}"
    ;;
  *)
    [[ ${#positional[@]} -eq 0 ]] || die "Unexpected argument: ${positional[0]}"
    ;;
  esac
}

# Print Command Usage Help
function print_help() {
  cat <<EOF
Usage: $(basename "$0") [command] [options]

Commands:
  encrypt                         Encrypt a secret as an Ansible-Vault variable
  help, --help, -h                Display this help message
  (none)                          Choose a command interactively

Encrypt Options:
  --string                        Encrypt a string (prompted, input hidden)
  --file [path] [varname]         Encrypt a file's content (prompts for missing values)
  --target <clipboard|ansible>    Copy to clipboard or append to group_vars/all/encrypted.yml
                                  (prompted if omitted)

Global Options:
  --dev-dir <path>                Use a local project directory instead of the installed one
EOF
}

# --               -- #
# --     SETUP     -- #
# --               -- #

# Prepare everything needed to encrypt
function setup() {
  resolve_target_dir
  load_utils
  tty_styles || warn "Failed to load TTY Styles."
  set_modes || warn "Failed to set Script Modes."
  init_brew || warn "Failed to initialize Homebrew."
  read_config || die "Failed to read Config File."
  export_dynamic_vars || die "Failed to export Dynamic Environment Variables."
  resolve_target_dir # Re-resolve: the config may set ONESETUP_PROJECT_DEV_DIR / ONESETUP_SYSTEM_INSTALL_DIR
  install_deps

  # Vars file for target 'ansible' (an existing ONESETUP_VARFILE_ENCRYPTED wins)
  VARFILE="${ONESETUP_VARFILE_ENCRYPTED:-${TARGET_DIR}/group_vars/all/encrypted.yml}"
}

# Set TARGET_DIR: --dev-dir > ONESETUP_PROJECT_DEV_DIR > ONESETUP_SYSTEM_INSTALL_DIR > default
function resolve_target_dir() {
  local default_dir="$HOME/.local/share/onesetup"
  local dir="${ARG_DEV_DIR:-${ONESETUP_PROJECT_DEV_DIR:-${ONESETUP_SYSTEM_INSTALL_DIR:-$default_dir}}}"

  [[ -d "$dir" ]] || die "Target directory does not exist: ${C_CYAN:-}${dir}${C_RESET:-}"

  TARGET_DIR="$(CDPATH='' cd -- "$dir" && pwd -P)"
  export ONESETUP_SYSTEM_TARGET_DIR="$TARGET_DIR" # used by Ansible
}

# Source the Utility Script from TARGET_DIR
function load_utils() {
  local util_script="${TARGET_DIR}/scripts/util.sh"

  [[ -r "$util_script" ]] || die "Utility Script not found: ${util_script}"
  # shellcheck source=/dev/null
  source "$util_script" || die "Failed to source Utility Script: ${util_script}"
}

# Install missing dependencies
function install_deps() {
  local os pkg
  local pkgs=("ansible" "gum")

  os="$(detect_os)"

  for pkg in "${pkgs[@]}"; do
    if command -v "$pkg" &>/dev/null; then
      continue
    fi

    echo -e "${I_INFO}Dependency missing: ${C_RED}${pkg}${C_RESET}. Installing..." >&2

    case "$os" in
    osx)
      command -v brew &>/dev/null ||
        die "Homebrew is not installed. Install it from ${C_BLUE}https://brew.sh${C_RESET} & re-run this script."
      brew install "$pkg" || die "Failed to install: ${pkg}"
      ;;
    linux)
      install_linux_pkg "$pkg" || die "Failed to install: ${pkg}"
      ;;
    windows)
      die "Windows support coming soon."
      ;;
    *)
      die "Unsupported OS: ${os}"
      ;;
    esac
  done
}

# --                 -- #
# --     PROMPTS     -- #
# --                 -- #

# Ask for the subcommand (prints "encrypt", "help" or nothing if cancelled)
function prompt_subcommand() {
  case "$(choose "Choose:" "Encrypt" "Help")" in
  "Encrypt") echo "encrypt" ;;
  "Help") echo "help" ;;
  esac
}

# Ask what to encrypt (prints "string", "file" or nothing if cancelled)
function prompt_action() {
  case "$(choose "Choose:" "Encrypt String" "Encrypt File Content")" in
  "Encrypt String") echo "string" ;;
  "Encrypt File Content") echo "file" ;;
  esac
}

# Ask for the output target (prints "clipboard", "ansible" or nothing if cancelled)
function prompt_output_target() {
  case "$(choose "Choose Output Target:" "Copy to Clipboard" "Save to ${VARFILE}")" in
  "Copy to Clipboard") echo "clipboard" ;;
  "Save to ${VARFILE}") echo "ansible" ;;
  esac
}

# --                 -- #
# --     ENCRYPT     -- #
# --                 -- #

# Validate an Ansible variable name: validate_varname <varname>
function validate_varname() {
  [[ -n "$1" ]] || die "Variable name cannot be empty."
  if [[ ! "$1" =~ ^[a-zA-Z0-9_]+$ ]]; then
    die "Invalid characters in variable name: '$1' (allowed: letters, numbers, underscores)"
  fi
}

# Set ARG_TARGET (prompt if needed) & check for duplicates BEFORE encrypting: resolve_output_target <varname>
function resolve_output_target() {
  local varname="$1"

  if [[ -z "$ARG_TARGET" ]]; then
    if [[ -t 0 ]]; then
      ARG_TARGET="$(prompt_output_target)"
    else
      ARG_TARGET="clipboard"
    fi
  fi

  if [[ -z "$ARG_TARGET" ]]; then
    warn "No target selected. Aborting."
    exit 0
  fi

  if [[ "$ARG_TARGET" == "ansible" ]] && grep -qE "^${varname}:" "$VARFILE" 2>/dev/null; then
    die "Variable [ ${C_PURPLE}${varname}${C_RESET} ] already exists in [ ${C_PURPLE}${VARFILE}${C_RESET} ]. Please choose a different name."
  fi
}

# Encrypt stdin as an Ansible variable: vault_encrypt <varname> < plaintext
# (reading the plaintext from stdin keeps secrets out of the process list)
function vault_encrypt() {
  ansible-vault encrypt_string \
    --vault-id "onesetup@prompt" \
    --encrypt-vault-id "onesetup" \
    --stdin-name "$1"
}

# Write the encrypted variable to ARG_TARGET: write_output <encrypted> <varname>
function write_output() {
  local encrypted="$1" varname="$2"

  case "$ARG_TARGET" in
  clipboard)
    printf '%s\n' "$encrypted" | copy_to_clipboard
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_PURPLE}${varname}${C_RESET} ] copied to clipboard"
    ;;
  ansible)
    mkdir -p "$(dirname "$VARFILE")"
    # Ensure the file ends with a newline, so the new variable starts on its own line
    if [[ -s "$VARFILE" && -n "$(tail -c 1 "$VARFILE")" ]]; then
      echo >>"$VARFILE"
    fi
    printf '%s\n' "$encrypted" >>"$VARFILE"
    echo -e "${I_OK}Encrypted Ansible Variable [ ${C_PURPLE}${varname}${C_RESET} ] appended to [ ${C_PURPLE}${VARFILE}${C_RESET} ]"
    ;;
  esac
}

# Action 'string': encrypt a prompted secret
function encrypt_string() {
  local secret varname encrypted

  printf '%b' "${I_ASK}Secret to Encrypt (hidden): "
  read -rs secret
  echo
  [[ -n "$secret" ]] || die "Secret cannot be empty."

  printf '%b' "${I_ASK}Variable Name: "
  read -r varname
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(printf '%s' "$secret" | vault_encrypt "$varname")" || die "Encryption failed."
  write_output "$encrypted" "$varname"
}

# Action 'file': encrypt a file's content (exact content, incl. trailing newlines)
function encrypt_file() {
  local filepath="$ARG_FILE" varname="$ARG_VARNAME" default_name encrypted

  # Pick a file if no path was given
  if [[ -z "$filepath" ]]; then
    filepath="$(
      gum file "$HOME" \
        --cursor.foreground "$GUM_COLOR" \
        --header.foreground "$GUM_COLOR" \
        --selected.foreground "$GUM_COLOR" \
        --all \
        --height=100 || true
    )"
    if [[ -z "$filepath" ]]; then
      warn "No file selected. Aborting."
      exit 0
    fi
  fi
  [[ -f "$filepath" && -r "$filepath" ]] || die "File not found or not readable: ${filepath}"

  # Variable name: argument > prompt (prefilled from the file name) > file name
  if [[ -z "$varname" ]]; then
    default_name="$(basename "$filepath")"
    default_name="${default_name//[^a-zA-Z0-9_]/_}"
    if [[ -t 0 ]]; then
      varname="$(
        gum input \
          --cursor.foreground "$GUM_COLOR" \
          --header.foreground "$GUM_COLOR" \
          --prompt.foreground "$GUM_COLOR" \
          --value "$default_name" \
          --header "Adjust variable name (or press Enter to keep default):" \
          --placeholder "$default_name" \
          --width 50 || true
      )"
    fi
    varname="${varname:-$default_name}"
  fi
  validate_varname "$varname"

  resolve_output_target "$varname"
  encrypted="$(vault_encrypt "$varname" <"$filepath")" || die "Encryption failed."
  write_output "$encrypted" "$varname"
}

# Call Main Function with args
main "$@"
